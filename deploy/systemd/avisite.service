# /etc/systemd/system/avisite.service
#   sudo useradd --system --home /srv/avisite --shell /usr/sbin/nologin avisite
#   sudo install -d -o avisite -g avisite -m 700 /srv/avisite/app/App_Data
#   sudo systemctl daemon-reload && sudo systemctl enable --now avisite
# Secrets live in /etc/avisite/avisite.env (chmod 600, owned by root):
#   PayPal__Mode=Live
#   PayPal__ClientId=...
#   PayPal__ClientSecret=...
#   PayPal__WebhookId=...
#   Admin__PasswordHash=pbkdf2-sha256$...
#   Site__DiscordInviteUrl=https://discord.gg/...
#   Site__ContactEmail=...

[Unit]
Description=AVI Robotics public site + shop (ASP.NET Core)
After=network.target

[Service]
Type=notify
User=avisite
Group=avisite
WorkingDirectory=/srv/avisite/app
ExecStart=/usr/bin/dotnet /srv/avisite/app/AviSite.Web.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_NOLOGO=1
EnvironmentFile=/etc/avisite/avisite.env
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=avisite

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/avisite/app/App_Data
UMask=0077

[Install]
WantedBy=multi-user.target
