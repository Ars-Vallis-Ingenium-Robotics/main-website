<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Fail the build if any package (including SQLite's native library) has a known vulnerability. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite: one file in the data directory (App_Data/site.db). The bundle is pinned to the patched native
         SQLite (CVE-2025-6965 fixed in 2.1.12+); don't let it float back down. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-only settings (fake PayPal, dev admin password) must never reach the server. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Content Update="Store\catalog.seed.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="legacy-static\**" CopyToPublishDirectory="PreserveNewest" />
    <!-- Site copy (Markdown) lives at the repo root in content/; ship it next to the app. -->
    <None Include="..\..\content\**\*.md" LinkBase="content" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
