<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev-only settings (fake PayPal, dev admin password) must never reach the server. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Content Update="Store\catalog.seed.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="legacy-static\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
