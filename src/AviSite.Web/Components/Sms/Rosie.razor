@page "/sms/rosie"
@* Copy: content/sms/rosie.md *@

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>
@{ var hero = c["hero"]; var spec = c["spec"]; var model = c["model"]; var poster = c["poster"]; }
<section class="sms-page-hero">
    <div class="wrap sms-page-hero__grid">
        <div>
            <p class="sms-kicker">@hero.Inline("kicker")</p>
            <h1 class="sms-page-hero__title">@hero.Inline("title")</h1>
            <p class="sms-page-hero__lede">@hero.Inline()</p>
        </div>
        <Photo Key="@hero.Photo" Sizes="(min-width: 56rem) 50vw, 100vw" Eager="true" Class="photo--frame" />
    </div>
</section>

<section class="sms-section">
    <div class="wrap split">
        <div class="split__head">
            <p class="sms-kicker sms-kicker--dark">@spec.Inline("kicker")</p>
            <h2 class="sms-h2">@spec.Inline("title")</h2>
        </div>
        <SpecSheet Class="reveal" Rows="@spec.Pairs()" />
    </div>
</section>

<section class="sms-section sms-section--model">
    <div class="wrap split split--model">
        <div class="split__head">
            <p class="sms-kicker sms-kicker--dark">@model.Inline("kicker")</p>
            <h2 class="sms-h2">@model.Inline("title")</h2>
            <p class="lede">@model.Inline()</p>
        </div>
        <Model3D Name="rosie" Alt="@model.Text("alt")" SizeLabel="@model.Text("size")" />
    </div>
</section>

<section class="sms-section sms-section--deep">
    <div class="wrap">
        <p class="sms-kicker">@poster.Inline("kicker")</p>
        <h2 class="sms-h2">@poster.Inline("title")</h2>
        <Photo Key="@poster.Photo" Sizes="(min-width: 56rem) 70vw, 100vw" Class="sms-poster reveal" />
    </div>
</section>

<section class="sms-section">
    <div class="wrap sms-chapters">
        @foreach (var ch in c["chapters"].Items)
        {
            <article class="sms-chapter reveal">
                <h3>@ch.Title</h3>
                @ch.Html()
            </article>
        }
    </div>
</section>

<section class="sms-section sms-section--flush">
    <p class="filmstrip-hint" aria-hidden="true">Scroll sideways →</p>
    <div class="filmstrip" tabindex="0" aria-label="ROSIE photos, scroll sideways">
        @foreach (var row in c["photos"].Rows())
        {
            var tall = row.ElementAtOrDefault(1) == "tall";
            <Photo Key="@row[0]" Sizes="@(tall ? "(min-width: 56rem) 30vw, 70vw" : "(min-width: 56rem) 40vw, 85vw")" Class="filmstrip__item" Ratio="@(tall ? "2 / 3" : null)" />
        }
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("sms/rosie");
}
