@page "/sms"
@* Copy: content/sms/home.md *@

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>
@{ var hero = c["hero"]; var hb = c["hero.buttons"].Links(); }
<section class="sms-hero">
    <Photo Key="@hero.Photo" Sizes="100vw" Eager="true" Class="sms-hero__bg" Focus="35% 75%" />
    <div class="wrap sms-hero__copy">
        <p class="sms-kicker">@hero.Inline("kicker")</p>
        <h1 class="sms-hero__title">@hero.Inline("title")</h1>
        <p class="sms-hero__lede">@hero.Inline()</p>
        <div class="sms-hero__actions">
            @for (var i = 0; i < hb.Count; i++) { <CopyLink Link="@hb[i]" Class="@(i == 0 ? "btn btn--sms" : "btn btn--ghost-on-ink")" /> }
        </div>
    </div>
</section>
@{ var mission = c["mission"]; }
<section class="sms-section" aria-labelledby="mission-title">
    <div class="wrap sms-mission reveal">
        <p class="sms-kicker sms-kicker--dark" id="mission-title">@mission.Inline("kicker")</p>
        <blockquote class="sms-mission__quote">@mission.Html()</blockquote>
        <p class="sms-mission__source">@mission.Inline("source")</p>
    </div>
</section>

<section class="sms-section sms-section--deep">
    <div class="wrap sms-machines">
        @foreach (var m in c["machines"].Items)
        {
            <a class="sms-machine reveal" href="@Copy.Href(m.Value("href") ?? "sms:/")">
                <Photo Key="@m.Photo" Sizes="(min-width: 56rem) 45vw, 100vw" Class="sms-machine__photo no-zoom" Ratio="3 / 2" Focus="@m.Value("focus")" />
                <span class="sms-machine__tag">@m.Inline("tag")</span>
                <span class="sms-machine__name">@m.Title</span>
                <span class="sms-machine__full">@m.Inline()</span>
            </a>
        }
    </div>
</section>
@{ var rec = c["record"]; }
<section class="sms-section">
    <div class="wrap sms-record">
        <div class="reveal">
            <p class="sms-kicker sms-kicker--dark">@rec.Inline("kicker")</p>
            <p class="sms-record__score" aria-label="@rec.Text("score-label")"><span aria-hidden="true">@rec.Inline("score")</span></p>
            <p class="sms-record__text">@rec.Inline()</p>
            <CopyLink Link="@rec.Link("link")" Class="link-arrow" />
        </div>
        <Photo Key="@rec.Photo" Sizes="(min-width: 56rem) 50vw, 100vw" Class="photo--frame reveal" />
    </div>
</section>

<section class="sms-section sms-section--cream" aria-labelledby="watch-title">
    <div class="wrap">
        <p class="sms-kicker sms-kicker--dark">@c["watch"].Inline("kicker")</p>
        <h2 class="sms-h2" id="watch-title">@c["watch"].Inline("title")</h2>
        <SmsVideos />
    </div>
</section>
@{ var sp = c["sponsors"]; }
<section class="sms-section sms-section--deep" aria-labelledby="sms-sponsors-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="sms-kicker">@sp.Inline("kicker")</p>
                <h2 class="sms-h2" id="sms-sponsors-title">@sp.Inline("title")</h2>
            </div>
            <CopyLink Link="@sp.Link("button")" Class="btn btn--sms" />
        </div>
        <SponsorWall Class="sponsor-wall--sms" />
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("sms/home");
}
