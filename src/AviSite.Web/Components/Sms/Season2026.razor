@page "/sms/2026"
@* Copy: content/sms/season-2026.md · timeline: content/timelines/sms-2026.md *@
@inject ClubData Data

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>
@{ var hero = c["hero"]; }
<section class="sms-page-hero sms-page-hero--photo">
    <Photo Key="@hero.Photo" Sizes="100vw" Eager="true" Class="sms-hero__bg" />
    <div class="wrap sms-hero__copy">
        <p class="sms-kicker">@hero.Inline("kicker")</p>
        <h1 class="sms-page-hero__title">@hero.Inline("title")</h1>
        <p class="sms-page-hero__lede">@hero.Inline()</p>
    </div>
</section>
@{ var next = c["timeline.next"]; var nl = next.Link("link"); }
<section class="sms-section">
    <div class="wrap">
        <Timeline Items="@(Data.Timeline("sms-2026"))" Id="sms26" Class="timeline--sms" NextWhen="@next.Text("when")" NextTitle="@next.Text("title")"
                  NextBody="@next.Text()" NextHref="@nl.Href" NextLink="@nl.PlainText" />
    </div>
</section>
@{ var rec = c["record"]; }
<section class="sms-section sms-section--deep">
    <div class="wrap sms-record">
        <div class="reveal">
            <p class="sms-kicker">@rec.Inline("kicker")</p>
            <p class="sms-record__score" aria-label="@rec.Text("score-label")"><span aria-hidden="true">@rec.Inline("score")</span></p>
            <p class="sms-record__text">@rec.Inline()</p>
        </div>
        <Photo Key="@rec.Photo" Sizes="(min-width: 56rem) 50vw, 100vw" Class="photo--frame reveal" />
    </div>
</section>

<section class="sms-section sms-section--cream" aria-labelledby="watch-title">
    <div class="wrap">
        <p class="sms-kicker sms-kicker--dark">@c["watch"].Inline("kicker")</p>
        <h2 class="sms-h2" id="watch-title">@c["watch"].Inline("title")</h2>
        <SmsVideos />
    </div>
</section>

<section class="sms-section sms-section--flush" aria-label="Photos from St. John's">
    <div class="wrap"><p class="sms-kicker">@c["canada"].Inline("kicker")</p></div>
    <Collage Keys="@c["canada"].List()" Label="Photos from St. John's" Class="collage-band--sms" />
</section>
@{ var docs = c["docs"]; }
<section class="sms-section" aria-labelledby="docs-title">
    <div class="wrap split">
        <div class="split__head">
            <p class="sms-kicker sms-kicker--dark">@docs.Inline("kicker")</p>
            <h2 class="sms-h2" id="docs-title">@docs.Inline("title")</h2>
            @docs.Html()
            <Photo Key="@docs.Photo" Sizes="(min-width: 56rem) 40vw, 100vw" Class="photo--frame docs__poster" />
        </div>
        <ul class="docs reveal" role="list">
            @foreach (var row in c["docs.files"].Rows())
            {
                <li><a class="docs__link" href="/files/sms-2026/@row[1]" target="_blank" rel="noopener"><span class="docs__title">@Copy.Inline(row[0])</span><span class="docs__note">@Copy.Inline(row.ElementAtOrDefault(2))</span></a></li>
            }
        </ul>
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("sms/season-2026");
}
