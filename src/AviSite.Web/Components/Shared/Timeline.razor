@*
    Vertical timeline. A block with moments opens into its own secondary timeline:
      - with JS (timeline.js) the clicked block morphs into the sub-timeline (View Transitions where supported);
      - without JS the link jumps to #sub-…, which CSS shows via :target.
    Every moment in a sub-timeline opens a pop-up (<dialog>, see dialogs.js) with the full photo and story.
    The main timeline always ends on a dashed "to be continued" node: the story isn't finished.
*@
<div class="tl @Class" data-timeline>
    <ol class="timeline" id="@($"{Id}-main")">
        @for (var i = 0; i < Items.Count; i++)
        {
            var m = Items[i];
            var sub = m.Moments is { Count: > 0 } ? $"{Id}-sub-{i}" : null;
            <li class="timeline__item reveal @(sub is null ? "" : "timeline__item--more")" id="@($"{Id}-{i}")">
                <div class="timeline__when mono">@m.When</div>
                <div class="timeline__body">
                    <h2 class="timeline__title">@Copy.Inline(m.Title)</h2>
                    <p>@Copy.Inline(m.Body)</p>
                    @if (sub is not null)
                    {
                        <a class="timeline__open" href="#@sub" data-sub="@sub">
                            <span>Open this chapter</span><span class="timeline__count mono">@m.Moments!.Count moments</span>
                        </a>
                    }
                </div>
                @if (m.Photo is not null)
                {
                    @if (sub is not null)
                    {
                        <a class="timeline__photo-link" href="#@sub" data-sub="@sub" aria-label="Open @Copy.Plain(m.Title)">
                            <Photo Key="@m.Photo" Sizes="(min-width: 56rem) 34vw, 100vw" Class="timeline__photo photo--frame no-zoom" />
                        </a>
                    }
                    else
                    {
                        <Photo Key="@m.Photo" Sizes="(min-width: 56rem) 34vw, 100vw" Class="timeline__photo photo--frame" />
                    }
                }
            </li>
        }
        <li class="timeline__item timeline__item--next reveal">
            <div class="timeline__when mono">@NextWhen</div>
            <div class="timeline__body">
                <h2 class="timeline__title">@NextTitle</h2>
                <p>@NextBody</p>
                @if (NextHref is not null) { <a class="link-arrow" href="@NextHref">@NextLink</a> }
            </div>
        </li>
    </ol>

    @for (var i = 0; i < Items.Count; i++)
    {
        var m = Items[i];
        if (m.Moments is not { Count: > 0 }) { continue; }
        var sub = $"{Id}-sub-{i}";
        <section class="subtl" id="@sub" aria-label="@Copy.Plain(m.Title), what happened">
            <header class="subtl__head">
                <a class="subtl__back" href="#@($"{Id}-{i}")" data-sub-close>
                    <span aria-hidden="true">←</span> Back to the full timeline
                </a>
                <div class="subtl__headline">
                    @if (m.Photo is not null)
                    {
                        <Photo Key="@m.Photo" Sizes="(min-width: 56rem) 18rem, 40vw" Class="subtl__cover no-zoom" Ratio="3 / 2" Alt="" />
                    }
                    <div>
                        <p class="subtl__when mono">@m.When</p>
                        <h2 class="subtl__title">@Copy.Inline(m.Title)</h2>
                        <p class="subtl__lede">@Copy.Inline(m.Body)</p>
                    </div>
                </div>
            </header>
            <ol class="subtl__list" role="list">
                @for (var k = 0; k < m.Moments.Count; k++)
                {
                    var mo = m.Moments[k];
                    var dlg = $"{Id}-m-{i}-{k}";
                    <li class="subtl__item" style="--i: @k">
                        <a class="subtl__card @(mo.Photo is null ? "subtl__card--text" : "")" href="#@dlg" data-dialog id="@(dlg)-open">
                            @if (mo.Photo is not null)
                            {
                                <Photo Key="@mo.Photo" Sizes="(min-width: 56rem) 14rem, 40vw" Class="subtl__thumb no-zoom" Ratio="4 / 3" Alt="" />
                            }
                            <span class="subtl__text">
                                <span class="subtl__date mono">@mo.Date</span>
                                <span class="subtl__name">@Copy.Inline(mo.Title)</span>
                                @if (mo.Body is not null) { <span class="subtl__body">@Copy.Plain(mo.Body)</span> }
                            </span>
                            <span class="subtl__more" aria-hidden="true">+</span>
                        </a>
                    </li>
                }
            </ol>
            @if (i + 1 < Items.Count && Items[i + 1].Moments is { Count: > 0 })
            {
                <p class="subtl__next"><span class="mono">Up next · @Items[i + 1].When</span> <a class="link-arrow" href="#@($"{Id}-sub-{i + 1}")" data-sub="@($"{Id}-sub-{i + 1}")">Next chapter</a></p>
            }
        </section>

        @for (var k = 0; k < m.Moments.Count; k++)
        {
            var mo = m.Moments[k];
            var dlg = $"{Id}-m-{i}-{k}";
            <dialog class="sheet moment-sheet" id="@dlg" aria-labelledby="@(dlg)-title">
                <div class="sheet__head">
                    <div>
                        <p class="moment-sheet__date mono">@mo.Date · @Copy.Plain(m.Title)</p>
                        <h3 class="sheet__title" id="@(dlg)-title">@Copy.Inline(mo.Title)</h3>
                    </div>
                    <a class="sheet__close" href="#@sub" data-dialog-close aria-label="Close">×</a>
                </div>
                @if (mo.Photo is not null)
                {
                    <Photo Key="@mo.Photo" Sizes="(min-width: 48rem) 44rem, 100vw" Class="sheet__photo" Caption="@mo.Caption" />
                }
                @if (mo.Body is not null) { <div class="moment-sheet__body">@Copy.Blocks(mo.Body)</div> }
                @if (mo.Photo is null && mo.Body is null) { <p class="moment-sheet__body">Part of “@Copy.Plain(m.Title)”, @m.When.</p> }
            </dialog>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Milestone> Items { get; set; } = [];
    /// <summary>Prefix for element ids, unique per page (e.g. "history", "sms26").</summary>
    [Parameter] public string Id { get; set; } = "tl";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string NextWhen { get; set; } = "Next";
    [Parameter] public string NextTitle { get; set; } = "To be continued…";
    [Parameter] public string NextBody { get; set; } = "";
    [Parameter] public string? NextHref { get; set; }
    [Parameter] public string NextLink { get; set; } = "Be part of it";
}
