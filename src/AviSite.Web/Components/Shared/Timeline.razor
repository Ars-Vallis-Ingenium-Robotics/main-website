@using AviSite.Web.Content
@*
    Vertical timeline. Entries with More expand in place (<details>, no JS).
    It always ends on an open, dashed "to be continued" node: the story isn't finished.
*@
<ol class="timeline @Class">
    @foreach (var m in Items)
    {
        <li class="timeline__item reveal">
            <div class="timeline__when mono">@m.When</div>
            <div class="timeline__body">
                <h2 class="timeline__title">@m.Title</h2>
                <p>@m.Body</p>
                @if (m.More is { Count: > 0 })
                {
                    <details class="timeline__more">
                        <summary><span class="timeline__more-open">More</span><span class="timeline__more-close">Less</span></summary>
                        <div class="timeline__more-body">
                            @foreach (var para in m.More) { <p>@para</p> }
                            @if (m.MorePhoto is not null)
                            {
                                <Photo Key="@m.MorePhoto" Sizes="(min-width: 56rem) 30vw, 100vw" Class="photo--frame timeline__more-photo" Ratio="3 / 2" />
                            }
                        </div>
                    </details>
                }
            </div>
            @if (m.Photo is not null)
            {
                <Photo Key="@m.Photo" Sizes="(min-width: 56rem) 34vw, 100vw" Class="timeline__photo photo--frame" />
            }
        </li>
    }
    <li class="timeline__item timeline__item--next reveal">
        <div class="timeline__when mono">@NextWhen</div>
        <div class="timeline__body">
            <h2 class="timeline__title">@NextTitle</h2>
            <p>@NextBody</p>
            @if (NextHref is not null) { <a class="link-arrow" href="@NextHref">@NextLink</a> }
        </div>
    </li>
</ol>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ClubFacts.Milestone> Items { get; set; } = [];
    [Parameter] public string? Class { get; set; }
    [Parameter] public string NextWhen { get; set; } = "Next";
    [Parameter] public string NextTitle { get; set; } = "To be continued…";
    [Parameter] public string NextBody { get; set; } = "";
    [Parameter] public string? NextHref { get; set; }
    [Parameter] public string NextLink { get; set; } = "Be part of it";
}
