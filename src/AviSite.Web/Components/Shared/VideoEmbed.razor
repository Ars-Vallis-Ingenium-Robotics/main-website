@*
    Google Drive video embed. The file must be shared "Anyone with the link can view",
    otherwise Drive shows a sign-in wall inside the frame. CSP allows frame-src drive.google.com.
*@
<figure class="video @Class">
    <div class="video__frame">
        <iframe src="https://drive.google.com/file/d/@(DriveId)/preview" title="@Title" loading="lazy"
                allow="autoplay; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <figcaption class="video__caption">
        <span class="video__title">@Title</span>
        @if (Note is not null) { <span class="video__note">@Note</span> }
    </figcaption>
</figure>

@code {
    [Parameter, EditorRequired] public string DriveId { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Class { get; set; }
}
