@*
    YouTube embed (privacy-enhanced youtube-nocookie.com). The iframe loads lazily.
    CSP allows frame-src https://www.youtube-nocookie.com.
*@
<figure class="video @Class">
    <div class="video__frame">
        <iframe src="https://www.youtube-nocookie.com/embed/@(YouTubeId)?rel=0" title="@Title" loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <figcaption class="video__caption">
        <span class="video__title">@Title</span>
        @if (Note is not null) { <span class="video__note">@Note</span> }
    </figcaption>
</figure>

@code {
    [Parameter, EditorRequired] public string YouTubeId { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Class { get; set; }
}
