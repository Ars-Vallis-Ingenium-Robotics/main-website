@inject People PeopleDir
@* Round headshot from wwwroot/img/people/<slug> (or the photo a profile points to), or initials. *@
@if (photo is not null)
{
    <img class="avatar" src="/img/people/@(photo)-@(Size > 120 ? 320 : 160).webp" srcset="/img/people/@(photo)-160.webp 1x, /img/people/@(photo)-320.webp 2x"
         alt="" width="@Size" height="@Size" style="--size: @(Size)px" loading="lazy" decoding="async" />
}
else
{
    <span class="avatar avatar--initials" style="--size: @(Size)px" aria-hidden="true">@Initials</span>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 64;
    private string? photo;
    protected override void OnParametersSet() => photo = PeopleDir.PhotoSlug(People.SlugOf(Name));
    private string Initials => string.Concat(People.SplitNote(Name).Name.Replace("Dr. ", "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]).Take(2));
}
