@* Horizontal bar list for money ("Category | amount | note" rows from content). One hue, longest first, value printed on every row
   (it doubles as the table view). Bars are relative to the largest row; the share of the total is in the label. *@
@{
    var rows = Rows.Select(r => (Label: r.ElementAtOrDefault(0) ?? "", Amount: decimal.TryParse(r.ElementAtOrDefault(1), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var a) ? a : 0m, Note: r.ElementAtOrDefault(2)))
        .OrderByDescending(r => r.Amount).ToList();
    var max = rows.Count == 0 ? 1 : rows.Max(r => r.Amount);
    var total = Total ?? rows.Sum(r => r.Amount);
}
<figure class="money-bars">
    <figcaption class="money-bars__head">
        <span class="money-bars__title">@Title</span>
        <span class="money-bars__total mono">@Money(total) total</span>
    </figcaption>
    <ol class="money-bars__list" role="list">
        @foreach (var r in rows)
        {
            var pct = total == 0 ? 0 : Math.Round(r.Amount * 100 / total);
            <li class="money-bars__row" title="@r.Label: @Money(r.Amount) (@pct% of total)">
                <span class="money-bars__label">@r.Label</span>
                <span class="money-bars__value mono">@Money(r.Amount) <span class="money-bars__pct">@(pct < 1 ? "<1" : pct.ToString())%</span></span>
                <span class="money-bars__track" aria-hidden="true"><span class="money-bars__bar" style="--w: @((r.Amount * 100 / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                @if (!string.IsNullOrWhiteSpace(r.Note)) { <span class="money-bars__note">@Copy.Inline(r.Note)</span> }
            </li>
        }
    </ol>
</figure>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string[]> Rows { get; set; } = [];
    [Parameter] public string Title { get; set; } = "";
    /// <summary>Use a documented total instead of the sum of the rows.</summary>
    [Parameter] public decimal? Total { get; set; }
    private static string Money(decimal v) => "$" + Math.Round(v).ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
}
