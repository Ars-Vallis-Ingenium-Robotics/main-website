@using AviSite.Web.Content
@* Company org chart: one root, its direct reports, and their reports. Plain nested lists. *@
<div class="org">
    <div class="org__root reveal"><PersonCard Person="Root.Person" /></div>
    @if (Root.Reports is { Count: > 0 } reports)
    {
        <ul class="org__level" role="list">
            @foreach (var n in reports)
            {
                <li class="org__node reveal">
                    <PersonCard Person="n.Person" />
                    @if (n.Reports is { Count: > 0 } sub)
                    {
                        <ul class="org__sub" role="list">
                            @foreach (var s in sub) { <li><PersonCard Person="s.Person" /></li> }
                        </ul>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public ClubFacts.OrgNode Root { get; set; } = default!;
}
