@inject People PeopleDir
<article class="person @(photo is not null ? "person--photo" : "")">
    @if (photo is not null)
    {
        <img class="person__photo" src="/img/people/@(photo)-160.webp" srcset="/img/people/@(photo)-160.webp 1x, /img/people/@(photo)-320.webp 2x"
             alt="" width="160" height="160" loading="lazy" decoding="async" />
    }
    else
    {
        <span class="person__mono" aria-hidden="true">@Initials</span>
    }
    <span class="person__name"><PersonLink Name="@Person.Name" /></span>
    <span class="person__role">@Copy.Inline(Person.Role)</span>
    @if (Person.Group is not null) { <span class="person__group">@Person.Group</span> }
    @if (Person.Email is not null) { <a class="person__email mono" href="mailto:@Person.Email">@Person.Email</a> }
</article>

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;
    private string? photo;
    protected override void OnParametersSet() => photo = PeopleDir.PhotoSlug(Person.Slug);
    private string Initials => string.Concat(Person.Name.Replace("Dr. ", "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]).Take(2));
}
