@* A member's opt-in links and bio from content/people/<slug>.md. Renders nothing without a profile. *@
@inject People PeopleDir
@if (profile is not null && (profile.Links.Count > 0 || profile.Bio.Length > 0))
{
    <div class="profile">
        @if (profile.Bio.Length > 0) { <div class="profile__bio">@Copy.Blocks(profile.Bio)</div> }
        @if (profile.Links.Count > 0)
        {
            <ul class="profile__links" role="list">
                @foreach (var l in profile.Links)
                {
                    var ext = l.Href.StartsWith("http");
                    <li><a class="profile__link profile__link--@l.Kind" href="@l.Href" target="@(ext ? "_blank" : null)" rel="@(ext ? "noopener me" : null)">@l.Label</a></li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    private Profile? profile;
    protected override void OnParametersSet() => profile = PeopleDir.Profile(Slug);
}
