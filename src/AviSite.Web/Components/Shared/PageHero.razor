<section class="page-hero @(Tone is null ? "" : "page-hero--" + Tone)">
    <div class="wrap page-hero__inner">
        @if (Kicker is not null) { <p class="eyebrow eyebrow--on-ink">@Kicker</p> }
        <h1 class="page-hero__title">@Title</h1>
        @if (ChildContent is not null) { <div class="page-hero__lede">@ChildContent</div> }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Kicker { get; set; }
    [Parameter] public string? Tone { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
