@* Main menu. Labels and order: content/site.md → ## nav. *@
<ul class="nav__list">
    @foreach (var l in site["nav"].Links())
    {
        <li>
            <NavLink class="nav__link" href="@l.Href">
                <span>@l.Text</span>
                @if (l.Href == "/shop" && CartCount > 0)
                {
                    <span class="badge" aria-hidden="true">@CartCount</span><span class="visually-hidden">, @CartCount @(CartCount == 1 ? "item" : "items") in cart</span>
                }
            </NavLink>
        </li>
    }
    @{ var join = site["nav.join"].Link(); var joinShort = site["nav.join"].Text("short"); }
    <li>
        <a class="btn btn--accent btn--sm nav__join" aria-label="@join.PlainText" href="@join.Href" target="@join.Target" rel="@join.Rel">
            @* Full label when there's room; the short one ("Join") when the bar gets tight. *@
            <span class="nav__join-long">@join.Text</span><span class="nav__join-short" aria-hidden="true">@joinShort</span>
        </a>
    </li>
</ul>

@code {
    [Parameter] public int CartCount { get; set; }
    private PageCopy site = default!;
    protected override void OnInitialized() => site = Copy.Site;
}
