@* The signed-in corner of the main menu. Signed out: "Sign in" + the Join button.
   Signed in: the clock (Clock in / Clocked in · 1:02) as the main button, and an account menu with everything else. *@
@using AviSite.Web.Endpoints
@inject HoursStore Hours

@if (!signedIn)
{
    <li class="nav__signin-item"><a class="nav__link nav__signin" href="/admin/login">Sign in</a></li>
    @Join
}
else if (Sheet)
{
    <li class="nav__account-sheet">
        <p class="nav__account-name">@name</p>
        <ul role="list">
            <li><a class="btn btn--accent btn--sm" href="/hours">@(running is null ? "Clock in" : $"Clocked in · {HoursText.Clock(running.Duration(Hours.Now))[..^3]}")</a></li>
            @foreach (var (href, label) in links) { <li><a class="nav__link" href="@href">@label</a></li> }
            <li><form method="post" action="/admin/logout"><AntiforgeryToken /><button class="link-button" type="submit">Sign out</button></form></li>
        </ul>
    </li>
}
else
{
    <li>
        <a class="btn btn--accent btn--sm nav__join nav__clock @(running is null ? "" : "is-on")" href="/hours">
            @if (running is null) { <span>Clock in</span> }
            else { <span class="nav__clock-dot" aria-hidden="true"></span><span>Clocked in · <span data-clock-since="@running.StartUtc.ToUnixTimeSeconds()" data-clock-short>@HoursText.Clock(running.Duration(Hours.Now))[..^3]</span></span> }
        </a>
    </li>
    <li class="nav__account">
        <details class="account-menu">
            <summary class="account-menu__toggle" aria-label="Account: @name"><span class="account-menu__initial" aria-hidden="true">@initial</span></summary>
            <div class="account-menu__panel">
                <p class="account-menu__name">@name</p>
                <ul role="list">
                    @foreach (var (href, label) in links) { <li><a href="@href">@label</a></li> }
                </ul>
                <form method="post" action="/admin/logout"><AntiforgeryToken /><button class="link-button" type="submit">Sign out</button></form>
            </div>
        </details>
    </li>
}

@code {
    [Parameter] public bool Sheet { get; set; }
    [Parameter] public RenderFragment? Join { get; set; }
    [CascadingParameter] public HttpContext? Http { get; set; }
    private bool signedIn;
    private string name = "", initial = "?";
    private HoursEntry? running;
    private List<(string Href, string Label)> links = [];

    protected override void OnInitialized()
    {
        var u = Http?.User;
        signedIn = u?.Identity?.IsAuthenticated == true;
        if (!signedIn) return;
        var email = u!.FindFirst(AccountAuth.EmailClaim)?.Value;
        name = u.Identity?.Name ?? "Signed in";
        initial = name.Length > 0 ? char.ToUpperInvariant(name[0]).ToString() : "?";
        if (email is not null) running = Hours.Running(email);
        var admin = u.IsInRole("Admin");
        if (email is not null) links.Add(("/admin/hours", "My hours"));
        if (admin || u.IsInRole("Lead")) links.Add(("/admin/hours/team", "Team hours"));
        links.Add(("/admin/qr", admin ? "QR codes" : "My QR codes"));
        if (email is not null && (admin || u.IsInRole("Lead"))) links.Add(("/admin/people", "People"));
        if (admin) { links.Add(("/admin", "Shop orders")); links.Add(("/admin/countdowns", "Countdowns")); }
    }
}
