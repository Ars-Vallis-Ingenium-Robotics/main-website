@inherits LayoutComponentBase
@inject IOptions<SiteOptions> Site
@inject IOptions<NonprofitOptions> Nonprofit
@inject CartCookie Cart
@inject SmsUrls SmsLinks

<HeadContent><meta name="theme-color" content="#101011" /></HeadContent>
<a class="skip-link" href="#main">Skip to content</a>
<div class="scroll-progress" aria-hidden="true"></div>

<header class="site-header">
    <div class="wrap site-header__bar">
        <a class="brand" href="/" aria-label="@Site.Value.Name home">
            <img class="brand__mark" src="/img/brand/avi-dog-sm.webp" alt="" width="32" height="40" />
            <span class="brand__word">AVI<span class="brand__word-sub">Robotics</span></span>
        </a>

        <nav class="nav nav--wide" aria-label="Main">
            <NavLinks CartCount="cartCount" />
        </nav>

        <details class="nav nav--narrow">
            <summary class="nav__toggle">
                <span>Menu</span>
                @if (cartCount > 0) { <span class="badge" aria-hidden="true">@cartCount</span><span class="visually-hidden">, @cartCount @(cartCount == 1 ? "item" : "items") in cart</span> }
            </summary>
            <nav class="nav__sheet" aria-label="Main (menu)">
                <NavLinks CartCount="cartCount" />
            </nav>
        </details>
    </div>
</header>

<main id="main" tabindex="-1">
    @Body
</main>

<footer class="site-footer">
    <div class="wrap site-footer__grid">
        <div class="site-footer__about">
            <img class="site-footer__letters" src="/img/brand/avi-letters-white.webp" alt="" width="153" height="120" loading="lazy" />
            <p class="site-footer__name">@Site.Value.LongName</p>
            <p class="muted">A student-led engineering club at Fresno State and home of Sequoia Marine Solutions, our MATE ROV company.</p>
            <p class="site-footer__legal">
                @Nonprofit.Value.LegalName is a @Nonprofit.Value.Status nonprofit organization.
                <Ein />. Donations are tax-deductible to the extent allowed by law.
            </p>
        </div>
        <nav class="site-footer__links" aria-label="Footer">
            <p class="eyebrow eyebrow--plain">Club</p>
            <ul>
                <li><a href="/about">About</a></li>
                <li><a href="/history">History</a></li>
                <li><a href="/leadership">Leadership</a></li>
                <li><a href="/teams">Teams</a></li>
                <li><a href="/join">Join</a></li>
            </ul>
        </nav>
        <nav class="site-footer__links" aria-label="More">
            <p class="eyebrow eyebrow--plain">More</p>
            <ul>
                <li><a href="@SmsLinks.Sms()">Sequoia Marine Solutions</a></li>
                <li><a href="/sponsors">Sponsor or donate</a></li>
                <li><a href="/shop">Shop</a></li>
                @if (Site.Value.DiscordInviteUrl is { } d) { <li><a href="@d" rel="noopener">Discord</a></li> }
                @if (Site.Value.YouTubeUrl is { } yt) { <li><a href="@yt" rel="noopener">YouTube</a></li> }
                @if (Site.Value.LinktreeUrl is { } lt) { <li><a href="@lt" rel="noopener">Linktree</a></li> }
                @if (Site.Value.PortalUrl is { } p) { <li><a href="@p">Member portal</a></li> }
            </ul>
        </nav>
    </div>
    <div class="wrap site-footer__base">
        <p class="mono">© @DateTime.UtcNow.Year @Site.Value.LongName</p>
        @if (Site.Value.ContactEmail is { } email) { <p class="mono"><a href="mailto:@email">@email</a></p> }
    </div>
</footer>

@code {
    private int cartCount;
    protected override void OnInitialized() => cartCount = Cart.Count();
}
