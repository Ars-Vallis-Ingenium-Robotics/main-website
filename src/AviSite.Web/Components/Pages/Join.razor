@page "/join"
@* Copy: content/pages/join.md *@

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>

<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")">
    @c["hero"].Html()
</PageHero>

<section class="section">
    <div class="wrap join">
        <ol class="join-steps">
            @foreach (var (s, i) in c["steps"].Items.Select((s, i) => (s, i)))
            {
                <li class="reveal">
                    <span class="join-steps__num mono" aria-hidden="true">@(i + 1)</span>
                    <h2 class="h3">@s.Title</h2>
                    @s.Html()
                    @if (s.Has("button") && s.Link("button") is { Href: not "#" } b) { <CopyLink Link="b" Class="btn btn--accent" /> }
                </li>
            }
        </ol>
        <Photo Key="@(c["hero"].Value("poster") ?? "poster-club")" Sizes="(min-width: 56rem) 28vw, 80vw" Class="join__poster photo--frame reveal" />
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/join");
}
