@page "/not-found"
@* Copy: content/pages/not-found.md *@

<PageTitle>@c.Meta("title")</PageTitle>

<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")">
    <p>@c["hero"].Inline()</p>
</PageHero>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private PageCopy c = default!;
    protected override void OnInitialized()
    {
        c = Copy.Page("pages/not-found");
        if (HttpContext is { Response.HasStarted: false }) HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
    }
}
