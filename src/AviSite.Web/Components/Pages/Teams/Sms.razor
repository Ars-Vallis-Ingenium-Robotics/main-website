@page "/teams/sms"
@page "/teams/sequoia-marine-solutions"

<PageTitle>Sequoia Marine Solutions · AVI Robotics</PageTitle>
<HeadContent><meta name="description" content="Sequoia Marine Solutions is AVI Robotics' MATE ROV Competition team at Fresno State." /></HeadContent>

<PageHero Kicker="Team · MATE ROV" Title="Sequoia Marine Solutions" Tone="sms" Logo="/img/brand/sms-logo.webp" LogoAlt="Sequoia Marine Solutions logo">
    <p>A student company that designs, builds and pilots an underwater ROV for the MATE ROV Competition.</p>
</PageHero>

<section class="section">
    <div class="wrap split">
        <div class="split__head">
            <Eyebrow>The competition</Eyebrow>
            <h2 class="h2">Run like a company, judged like one.</h2>
        </div>
        <div class="prose">
            <p>The MATE ROV Competition asks student teams to act as small ocean-technology companies. Each season brings a new mission scenario based on real underwater work, and teams are scored on more than how the robot performs in the pool.</p>
            <SpecSheet Rows="@scoring" />
        </div>
    </div>
</section>

<section class="section section--ink depth">
    <div class="wrap depth__grid">
        <div class="depth__gauge" aria-hidden="true">
            <span>0 m</span><span>1</span><span>2</span><span>3</span><span>4 m</span>
        </div>
        <div>
            <Eyebrow Class="eyebrow--on-ink">This season's vehicle</Eyebrow>
            <h2 class="h2">This season's ROV</h2>
            <p class="note">TODO(confirm): vehicle name and specs.</p>
            <SpecSheet Class="spec--on-ink" Rows="@vehicle" />
        </div>
        <Figure Number="03" Caption="Current ROV, side profile on a white background" Ratio="4 / 3" Tone="sms" />
    </div>
</section>

<section class="section">
    <div class="wrap split">
        <div class="split__head">
            <Eyebrow>Get involved</Eyebrow>
            <h2 class="h2">Crew up.</h2>
        </div>
        <div class="prose">
            <p>SMS recruits from AVI members every fall. Pilots, mechanical, electrical, software, documentation and the presentation team all count.</p>
            <p><a class="btn btn--sms" href="/join">Join AVI to get on the team</a></p>
        </div>
    </div>
</section>

@code {
    private readonly IReadOnlyList<(string, string)> scoring =
    [
        ("Product demonstration", "Pool missions, timed"),
        ("Technical documentation", "Written report on the vehicle"),
        ("Engineering presentation", "Pitch to a judging panel"),
        ("Marketing display", "Company poster and booth"),
        ("Safety", "Inspection before entering the water"),
    ];
    private readonly IReadOnlyList<(string, string)> vehicle =
    [
        ("Frame", "TODO"),
        ("Thrusters", "TODO"),
        ("Control", "TODO"),
        ("Tether", "TODO"),
        ("Mass in air", "TODO"),
    ];
}
