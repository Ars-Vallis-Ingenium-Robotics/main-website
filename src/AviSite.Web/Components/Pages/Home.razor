@page "/"
@* Copy: content/pages/home.md *@
@inject ICatalog Catalog
@inject ClubData Data
@inject IOptions<StoreOptions> StoreOpts

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent>
    <meta name="description" content="@c.Meta("description")" />
</HeadContent>

<section class="landing" aria-labelledby="hero-title">
    <div class="landing__stage">
        <Photo Key="@(c["landing"].Value("photo") ?? "fall-group-2026")" Sizes="100vw" Eager="true" Class="landing__photo no-zoom" Focus="50% 55%" Alt="@c["landing"].Text("photo-alt")" />
        <div class="landing__veil" aria-hidden="true"></div>
        <h1 class="landing__mark" id="hero-title" aria-label="@c["landing"].Text("label")">
            <img class="landing__dog" src="/img/brand/avi-dog-480.webp" alt="" width="480" height="602" fetchpriority="high" />
            <span class="landing__words"><span class="landing__word">AVI</span><span class="landing__robotics">Robotics</span></span>
        </h1>
        @{ var phrases = c["landing.scramble"].List().Select(Copy.Plain).ToList(); }
        <p class="landing__sub" aria-hidden="true"><span class="scramble" data-scramble="@string.Join('|', phrases)">@phrases.FirstOrDefault()</span></p>
        <div class="landing__actions">
            @foreach (var (b, i) in c["landing.buttons"].Links().Select((b, i) => (b, i)))
            {
                <a class="btn @(i == 0 ? "btn--accent" : "btn--ghost-on-ink")" href="@b.Href" target="@b.Target" rel="@b.Rel">@b.Text</a>
            }
        </div>
        <a class="landing__cue" href="#intro"><span class="landing__cue-line" aria-hidden="true"></span><span class="mono">Scroll</span></a>
    </div>
</section>

<section class="section intro" id="intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
        @{ var intro = c["intro"]; var news = c["news"]; }
        <div class="intro__copy reveal">
            <p class="eyebrow">@intro.Inline("eyebrow")</p>
            <h2 class="h2" id="intro-title">@intro.Inline("title")</h2>
            <p class="lede">@intro.Inline()</p>
            <div class="hero__actions">
                <CopyLink Link="@intro.Link("button")" Class="btn btn--accent" />
                <CopyLink Link="@intro.Link("link")" Class="link-arrow" />
            </div>
        </div>
        <aside class="news reveal" aria-labelledby="news-title">
            <Photo Key="@news.Photo" Sizes="(min-width: 56rem) 30vw, 100vw" Class="news__photo" Ratio="4 / 3" />
            <div class="news__body">
                <p class="news__tag mono">@news.Inline("tag")</p>
                <h3 class="news__title" id="news-title">@news.Inline("title")</h3>
                <p>@news.Inline()</p>
            </div>
        </aside>
    </div>
</section>

<section class="stats-band" aria-label="2026 season in numbers">
    <div class="wrap stats-band__grid">
        @foreach (var s in Data.Stats("pages/home", "stats"))
        {
            <div class="stat-big reveal">
                <span class="stat-big__value">@Copy.Inline(s.Value)</span>
                <span class="stat-big__label">@Copy.Inline(s.Label)</span>
            </div>
        }
    </div>
</section>
@{ var worlds = c["worlds"]; }
<section class="section">
    <div class="wrap feature">
        <div class="feature__media reveal">
            <Photo Key="@worlds.Photo" Sizes="(min-width: 56rem) 55vw, 100vw" Class="photo--frame parallax" />
        </div>
        <div class="feature__copy reveal">
            <p class="eyebrow">@worlds.Inline("eyebrow")</p>
            <h2 class="h2">@worlds.Inline("title")</h2>
            <p class="lede">@worlds.Inline()</p>
            <CopyLink Link="@worlds.Link("link")" Class="link-arrow" />
        </div>
    </div>
</section>
@{ var what = c["what"]; }
<section class="section section--ink" aria-labelledby="what-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow eyebrow--on-ink">@what.Inline("eyebrow")</p>
                <h2 class="h2" id="what-title">@what.Inline("title")</h2>
            </div>
            <p class="lede-on-ink what__lede">@what.Inline()</p>
        </div>
        <ul class="what" role="list">
            @foreach (var card in what.Items)
            {
                var wide = card.Value("wide") is "yes" or "true";
                <li class="what__card @(wide ? "what__card--wide" : "") reveal">
                    @if (card.Value("photo") is { } ph)
                    {
                        <Photo Key="@ph" Sizes="@(wide ? "(min-width: 56rem) 50vw, 100vw" : "(min-width: 56rem) 25vw, 100vw")" Class="what__photo" Ratio="@(wide ? "16 / 9" : "4 / 3")" Alt="" />
                    }
                    <div class="what__body">
                        <h3 class="what__title">@card.Title</h3>
                        <p>@card.Inline()</p>
                        <CopyLink Link="@card.Link("link")" Class="link-arrow link-arrow--on-ink" />
                    </div>
                </li>
            }
        </ul>
    </div>
</section>
@{ var projects = c["projects"]; var pp = c["projects.photos"].List(); }
<section class="section" aria-labelledby="projects-title">
    <div class="wrap projects-band">
        <div class="projects-band__copy reveal">
            <p class="eyebrow">@projects.Inline("eyebrow")</p>
            <h2 class="h2" id="projects-title">@projects.Inline("title")</h2>
            <p class="lede">@projects.Inline()</p>
            <CopyLink Link="@projects.Link("button")" Class="btn btn--accent" />
        </div>
        <div class="projects-band__photos">
            @if (pp.Count > 0) { <Photo Key="@pp[0]" Sizes="(min-width: 56rem) 26vw, 60vw" Class="projects-band__a reveal" /> }
            @if (pp.Count > 1) { <Photo Key="@pp[1]" Sizes="(min-width: 56rem) 22vw, 50vw" Class="projects-band__b reveal" /> }
            @if (pp.Count > 2) { <Photo Key="@pp[2]" Sizes="(min-width: 56rem) 22vw, 50vw" Class="projects-band__c reveal" /> }
        </div>
    </div>
</section>

<section class="section section--flush" aria-label="Photos">
    <p class="filmstrip-hint" aria-hidden="true">Scroll sideways →</p>
    <div class="filmstrip" tabindex="0" aria-label="Photo highlights, scroll sideways">
        @foreach (var key in c["filmstrip"].List())
        {
            <Photo Key="@key" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        }
    </div>
</section>
@{ var outreach = c["outreach"]; }
<section class="section section--paper-2 section--outreach" aria-labelledby="outreach-title">
    <div class="wrap outreach">
        <div class="outreach__copy reveal">
            <p class="eyebrow">@outreach.Inline("eyebrow")</p>
            <h2 class="h2" id="outreach-title">@outreach.Inline("title")</h2>
            <p class="lede">@outreach.Inline()</p>
            <ul class="outreach__dates mono" role="list">
                @foreach (var d in c["outreach.dates"].ListHtml()) { <li>@d</li> }
            </ul>
        </div>
    </div>
    <Collage Keys="@c["outreach.photos"].List()" Label="Outreach photos" />
</section>
@{ var teams = c["teams"]; var sms = teams.Items.FirstOrDefault(); var mouse = teams.Items.Skip(1).FirstOrDefault(); }
<section class="section">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow">@teams.Inline("eyebrow")</p>
                <h2 class="h2">@teams.Inline("title")</h2>
            </div>
            <CopyLink Link="@teams.Link("link")" Class="link-arrow" />
        </div>
        <div class="team-cards">
            @if (sms is not null)
            {
                <div class="team-card team-card--sms reveal">
                    <Photo Key="@sms.Photo" Sizes="(min-width: 56rem) 50vw, 100vw" Class="team-card__photo" />
                    <div class="team-card__body">
                        <img class="team-card__logo" src="/img/brand/sms-logo.webp" alt="" width="72" height="72" loading="lazy" />
                        <span class="team-card__kicker">@sms.Inline("kicker")</span>
                        <h3 class="team-card__name"><a href="@Copy.Href(sms.Value("href") ?? "sms:/")">@sms.Title</a></h3>
                        <span class="team-card__desc">@sms.Inline()</span>
                        <span class="link-arrow" aria-hidden="true">@sms.Inline("more")</span>
                    </div>
                </div>
            }
            @if (mouse is not null)
            {
                <div class="team-card team-card--forming reveal">
                    <div class="team-card__body">
                        <span class="team-card__kicker">@mouse.Inline("kicker")</span>
                        <h3 class="team-card__name">@mouse.Title</h3>
                        <span class="team-card__desc">@mouse.Inline()</span>
                        <CopyLink Link="@mouse.Link("link")" Class="link-arrow" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>
@{ var shop = c["shop"]; }
<section class="section section--paper-2">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow">@shop.Inline("eyebrow")</p>
                <h2 class="h2">@shop.Inline("title")</h2>
            </div>
            <CopyLink Link="@shop.Link("link")" Class="link-arrow" />
        </div>
        @if (StoreOpts.Value.ComingSoon)
        {
            @* Between drops (prod): no product cards, just the shop page's coming-soon line. *@
            <p class="lede">@Copy.Page("pages/shop")["coming-soon"].Inline()</p>
        }
        else
        {
        <ul class="product-row">
            @foreach (var p in Catalog.Active.Take(3))
            {
                <li><ProductCard Product="p" /></li>
            }
        </ul>
        }
    </div>
</section>
@{ var sp = c["sponsors"]; }
<section class="section section--ink sponsors-band" aria-labelledby="sponsors-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow eyebrow--on-ink">@sp.Inline("eyebrow")</p>
                <h2 class="h2" id="sponsors-title">@sp.Inline("title")</h2>
            </div>
            <CopyLink Link="@sp.Link("link")" Class="link-arrow link-arrow--on-ink" />
        </div>
        <SponsorWall Class="sponsor-wall--compact" />
    </div>
</section>
@{ var support = c["support"]; var sb = c["support.buttons"].Links(); }
<section class="section section--accent">
    <div class="wrap support">
        <div>
            <p class="eyebrow eyebrow--on-accent">@support.Inline("eyebrow")</p>
            <h2 class="h2">@support.Inline("title")</h2>
        </div>
        <div class="support__body">
            <p>@support.Inline()</p>
            <div class="support__actions">
                @for (var i = 0; i < sb.Count; i++)
                {
                    <CopyLink Link="@sb[i]" Class="@(i == 0 ? "btn btn--ink" : i == 1 ? "btn btn--ghost-on-accent" : "link-arrow link-arrow--on-accent")" />
                }
            </div>
        </div>
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/home");
}
