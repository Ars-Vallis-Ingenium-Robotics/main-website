@page "/"
@using AviSite.Web.Content
@inject ICatalog Catalog
@inject IOptions<SiteOptions> Site
@inject IOptions<NonprofitOptions> Nonprofit
@inject SmsUrls SmsLinks

<PageTitle>AVI Robotics · Fresno State's award-winning robotics club</PageTitle>
<HeadContent>
    <meta name="description" content="AVI Robotics is a student-led 501(c)(3) engineering club at Fresno State. Our MATE ROV company, Sequoia Marine Solutions, won the 2026 World Championship Engineering Presentation award." />
</HeadContent>

<section class="landing" aria-labelledby="hero-title">
    <div class="landing__stage">
        <Photo Key="fall-group-2026" Sizes="100vw" Eager="true" Class="landing__photo no-zoom" Focus="50% 55%" Alt="About fifty AVI Robotics members in front of the Lyles College of Engineering, fall 2026" />
        <div class="landing__veil" aria-hidden="true"></div>
        <h1 class="landing__mark" id="hero-title" aria-label="AVI Robotics: Ars Vallis Ingenium, the Valley of Artistic Ingenuity">
            <img class="landing__dog" src="/img/brand/avi-dog-480.webp" alt="" width="480" height="602" fetchpriority="high" />
            <span class="landing__words"><span class="landing__word">AVI</span><span class="landing__robotics">Robotics</span></span>
        </h1>
        <p class="landing__sub" aria-hidden="true"><span class="scramble" data-scramble="Ars Vallis Ingenium|Valley of Artistic Ingenuity">Ars Vallis Ingenium</span></p>
        <div class="landing__actions">
            <a class="btn btn--accent" href="/join">Join the club</a>
            <a class="btn btn--ghost-on-ink" href="/history">Our story</a>
            <a class="btn btn--ghost-on-ink" href="/projects">Projects &amp; workshops</a>
        </div>
        <a class="landing__cue" href="#intro"><span class="landing__cue-line" aria-hidden="true"></span><span class="mono">Scroll</span></a>
    </div>
</section>

<section class="section intro" id="intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
        <div class="intro__copy reveal">
            <p class="eyebrow">Fresno State · Student-led · 501(c)(3)</p>
            <h2 class="h2" id="intro-title">The Valley of Artistic Ingenuity.</h2>
            <p class="lede">Fresno State students from every major who design, build and pilot robots, run hands-on projects, and bring engineering to the Central Valley. In our first year our MATE ROV company won a world-championship award.</p>
            <div class="hero__actions">
                <a class="btn btn--accent" href="/join">Join the club</a>
                <a class="link-arrow" href="/about">About AVI</a>
            </div>
        </div>
        <aside class="news reveal" aria-labelledby="news-title">
            <Photo Key="phantom-booth" Sizes="(min-width: 56rem) 30vw, 100vw" Class="news__photo" Ratio="4 / 3" />
            <div class="news__body">
                <p class="news__tag mono">Just in · fall 2026</p>
                <h3 class="news__title" id="news-title">We won the club booth decorating contest.</h3>
                <p>Our Ars Vallis Ingenium booth took first place in Fresno State's club booth decorating contest.</p>
            </div>
        </aside>
    </div>
</section>

<section class="stats-band" aria-label="2026 season in numbers">
    <div class="wrap stats-band__grid">
        @foreach (var s in ClubFacts.Season2026)
        {
            <div class="stat-big reveal">
                <span class="stat-big__value">@s.Value</span>
                <span class="stat-big__label">@s.Label</span>
            </div>
        }
    </div>
</section>
<section class="section">
    <div class="wrap feature">
        <div class="feature__media reveal">
            <Photo Key="worlds-award-stage" Sizes="(min-width: 56rem) 55vw, 100vw" Class="photo--frame parallax" />
        </div>
        <div class="feature__copy reveal">
            <p class="eyebrow">June 2026 · St. John's, Newfoundland</p>
            <h2 class="h2">A first-year team, on the world stage.</h2>
            <p class="lede">Sequoia Marine Solutions won the Engineering Presentation award at the MATE ROV World Championship, scoring 102 out of 100, an all-time record for the Pioneer class.</p>
            <a class="link-arrow" href="@SmsLinks.Sms("/2026")">The 2026 season</a>
        </div>
    </div>
</section>

<section class="section section--ink" aria-labelledby="what-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow eyebrow--on-ink">What we do</p>
                <h2 class="h2" id="what-title">Build things. Learn by doing. Give back.</h2>
            </div>
            <p class="lede-on-ink what__lede">AVI started with underwater robots, but it's here for any member who wants to make something real: robots, projects, workshops and outreach.</p>
        </div>
        <ul class="what" role="list">
            <li class="what__card what__card--wide reveal">
                <Photo Key="worlds-display" Sizes="(min-width: 56rem) 50vw, 100vw" Class="what__photo" Ratio="16 / 9" Alt="" />
                <div class="what__body">
                    <h3 class="what__title">Robots and teams</h3>
                    <p>Our teams compete and build year-round. Sequoia Marine Solutions builds underwater robots for MATE ROV, and a Micromouse team is forming.</p>
                    <a class="link-arrow link-arrow--on-ink" href="/teams">Our teams</a>
                </div>
            </li>
            <li class="what__card reveal">
                <Photo Key="bcp-build" Sizes="(min-width: 56rem) 25vw, 100vw" Class="what__photo" Ratio="4 / 3" Alt="" />
                <div class="what__body">
                    <h3 class="what__title">Blank Check Projects</h3>
                    <p>Four weeks, a small team and a theme: design and build an interactive display with moving parts, electronics and code. Blank check, because we're broke.</p>
                    <a class="link-arrow link-arrow--on-ink" href="/projects">How it works</a>
                </div>
            </li>
            <li class="what__card reveal">
                <Photo Key="workshop-code" Sizes="(min-width: 56rem) 25vw, 100vw" Class="what__photo" Ratio="4 / 3" Alt="" />
                <div class="what__body">
                    <h3 class="what__title">Workshops</h3>
                    <p>Friday nights in EE 389: programming, electronics, CAD and design, taught by members who learned it the same way.</p>
                    <a class="link-arrow link-arrow--on-ink" href="/projects">The tracks</a>
                </div>
            </li>
            <li class="what__card what__card--wide reveal">
                <Photo Key="pi-day-group" Sizes="(min-width: 56rem) 50vw, 100vw" Class="what__photo" Ratio="16 / 9" Alt="" />
                <div class="what__body">
                    <h3 class="what__title">Outreach</h3>
                    <p>MESA events, runs, regional competitions and open houses. Robots are a great way to start a conversation about engineering.</p>
                    <a class="link-arrow link-arrow--on-ink" href="#outreach-title">Where we've been</a>
                </div>
            </li>
        </ul>
    </div>
</section>

<section class="section" aria-labelledby="projects-title">
    <div class="wrap projects-band">
        <div class="projects-band__copy reveal">
            <p class="eyebrow">Projects &amp; workshops</p>
            <h2 class="h2" id="projects-title">No experience? Good. Start here.</h2>
            <p class="lede">Friday workshops teach programming, electronics and CAD from zero. Then every fall, new members team up for a Blank Check Project: four weeks to build an interactive display that moves, lights up and runs code.</p>
            <a class="btn btn--accent" href="/projects">Projects &amp; workshops</a>
        </div>
        <div class="projects-band__photos">
            <Photo Key="bcp-kit" Sizes="(min-width: 56rem) 26vw, 60vw" Class="projects-band__a reveal" />
            <Photo Key="bcp-solder" Sizes="(min-width: 56rem) 22vw, 50vw" Class="projects-band__b reveal" />
            <Photo Key="workshop-cad" Sizes="(min-width: 56rem) 22vw, 50vw" Class="projects-band__c reveal" />
        </div>
    </div>
</section>

<section class="section section--flush" aria-label="Photos">
    <p class="filmstrip-hint" aria-hidden="true">Scroll sideways →</p>
    <div class="filmstrip" tabindex="0" aria-label="Photo highlights, scroll sideways">
        <Photo Key="worlds-rosie-table" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="monterey-group" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="pool-guests" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="pool-jump" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="traditions-booth" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="worlds-shirt-front" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="mesa-outreach" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="bcp-workshop" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
        <Photo Key="phantom-booth" Sizes="(min-width: 56rem) 40vw, 85vw" Class="filmstrip__item" />
    </div>
</section>

<section class="section section--paper-2 section--outreach" aria-labelledby="outreach-title">
    <div class="wrap outreach">
        <div class="outreach__copy reveal">
            <p class="eyebrow">Outreach</p>
            <h2 class="h2" id="outreach-title">Out in the Valley.</h2>
            <p class="lede">We volunteer wherever students and families are learning about science and engineering: MESA events on campus, the Pi Day Run and the UHC Foundation Fun Run, and the MATE regional in Monterey, where our members judged and helped run the day.</p>
            <ul class="outreach__dates mono" role="list">
                <li>Feb 7, 2026 · MESA volunteering</li>
                <li>Mar 14, 2026 · Pi Day Run</li>
                <li>Mar 28, 2026 · UHC Foundation Fun Run</li>
                <li>Apr 11, 2026 · MESA volunteering</li>
                <li>Apr 25, 2026 · MATE Monterey regional (judges and volunteers)</li>
                <li>Oct 3, 2026 · MESA Saturday Academy</li>
                <li>Nov 7, 2026 · MESA, with Sundog</li>
            </ul>
        </div>
    </div>
    <Collage Keys="@outreach" Label="Outreach photos" />
</section>

<section class="section">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow">Teams</p>
                <h2 class="h2">Where the robots get built.</h2>
            </div>
            <a class="link-arrow" href="/teams">All teams</a>
        </div>
        <div class="team-cards">
            <div class="team-card team-card--sms reveal">
                <Photo Key="sms-pool-pilot" Sizes="(min-width: 56rem) 50vw, 100vw" Class="team-card__photo" />
                <div class="team-card__body">
                    <img class="team-card__logo" src="/img/brand/sms-logo.webp" alt="" width="72" height="72" loading="lazy" />
                    <span class="team-card__kicker">MATE ROV · Explorer class</span>
                    <h3 class="team-card__name"><a href="@SmsLinks.Sms()">Sequoia Marine Solutions</a></h3>
                    <span class="team-card__desc">Our underwater robotics company. Builders of ROSIE and ADAM.</span>
                    <span class="link-arrow" aria-hidden="true">Visit the SMS site</span>
                </div>
            </div>
            <div class="team-card team-card--forming reveal">
                <div class="team-card__body">
                    <span class="team-card__kicker">Forming · 2026–27</span>
                    <h3 class="team-card__name">Micromouse</h3>
                    <span class="team-card__desc">Small autonomous robots that map and solve a maze as fast as they can. No name yet, no members yet. Want in?</span>
                    <a class="link-arrow" href="/join">Tell us at a meeting</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section--paper-2">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow">Shop</p>
                <h2 class="h2">Wear the club.</h2>
            </div>
            <a class="link-arrow" href="/shop">All gear</a>
        </div>
        <ul class="product-row">
            @foreach (var p in Catalog.Active.Take(3))
            {
                <li><ProductCard Product="p" /></li>
            }
        </ul>
    </div>
</section>

<section class="section section--ink sponsors-band" aria-labelledby="sponsors-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow eyebrow--on-ink">2026 sponsors</p>
                <h2 class="h2" id="sponsors-title">They got us to Worlds.</h2>
            </div>
            <a class="link-arrow link-arrow--on-ink" href="/sponsors">All sponsors</a>
        </div>
        <SponsorWall Class="sponsor-wall--compact" />
    </div>
</section>

<section class="section section--accent">
    <div class="wrap support">
        <div>
            <p class="eyebrow eyebrow--on-accent">Support · @Nonprofit.Value.Status nonprofit</p>
            <h2 class="h2">Help us get back in the water.</h2>
        </div>
        <div class="support__body">
            <p>Sponsors and donors cover parts, pool time and travel to competition. AVI is a @Nonprofit.Value.Status, so gifts are tax-deductible. <Ein />.</p>
            <div class="support__actions">
                <a class="btn btn--ink" href="/donate">Donate</a>
                <a class="btn btn--ghost-on-accent" href="/sponsors">Become a sponsor</a>
                <a class="link-arrow link-arrow--on-accent" href="@Site.Value.SponsorPacketPath" target="_blank" rel="noopener">Sponsorship packet (PDF)</a>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<string> outreach =
    [
        "uhc-crowd", "pi-day-group", "uhc-kid", "monterey-crew", "mesa-feb-fun", "pi-day-demo",
        "uhc-tent", "monterey-pool", "mesa-outreach", "uhc-kids", "mesa-nov", "pi-day-booth",
        "monterey-volunteers", "mesa-apr", "traditions-demo",
        "mesa-oct-lawn", "traditions-crowd", "uhc-table", "traditions-float", "mesa-feb", "pool-day-crowd",
    ];
}
