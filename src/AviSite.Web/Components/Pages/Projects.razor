@page "/projects"
@* Copy: content/pages/projects.md *@

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>

<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")">
    @c["hero"].Html()
</PageHero>
@{ var ws = c["workshops"]; }
<section class="section" aria-labelledby="ws-title">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@ws.Inline("eyebrow")</p>
            <h2 class="h2" id="ws-title">@ws.Inline("title")</h2>
            <p class="lede">@ws.Inline()</p>
            <CopyLink Link="@ws.Link("button")" Class="btn btn--accent" />
        </div>
        <ul class="tracks" role="list">
            @foreach (var t in ws.Items)
            {
                <li class="track reveal">
                    @if (t.Value("photo") is { } ph) { <Photo Key="@ph" Sizes="(min-width: 56rem) 30vw, 100vw" Class="track__photo" Ratio="16 / 10" /> }
                    <div class="track__body">
                        <h3 class="track__title">@t.Title</h3>
                        <p>@t.Inline()</p>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>
@{ var bcp = c["bcp"]; }
<section class="section section--ink" aria-labelledby="bcp-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow eyebrow--on-ink">@bcp.Inline("eyebrow")</p>
                <h2 class="h2" id="bcp-title">@bcp.Inline("title")</h2>
            </div>
            <p class="lede-on-ink bcp__lede">@bcp.Inline()</p>
        </div>
        <div class="bcp">
            <div class="bcp__steps">
                <ol class="bcp-steps" role="list">
                    @foreach (var row in c["bcp.steps"].Rows())
                    {
                        <li><span class="mono">@Copy.Inline(row[0])</span> @Copy.Inline(row.ElementAtOrDefault(1))</li>
                    }
                </ol>
                <SpecSheet Class="spec--on-ink" Rows="@c["bcp.spec"].Pairs()" />
            </div>
            <Photo Key="@bcp.Photo" Sizes="(min-width: 56rem) 40vw, 100vw" Class="photo--frame bcp__kit" />
        </div>
    </div>
</section>

<section class="section section--flush section--ink" aria-label="Blank Check Project photos">
    <Collage Keys="@c["bcp.photos"].List()" Label="Blank Check Project photos" Class="collage-band--ink" />
</section>
@{ var rounds = c["rounds"]; }
<section class="section">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@rounds.Inline("eyebrow")</p>
            <h2 class="h2">@rounds.Inline("title")</h2>
        </div>
        <ul class="rounds" role="list">
            @foreach (var r in rounds.Items)
            {
                <li class="round reveal">
                    <span class="round__when mono">@r.Inline("when")</span>
                    <h3 class="round__title">@r.Title</h3>
                    <p>@r.Inline()</p>
                </li>
            }
        </ul>
    </div>
</section>
@{ var cta = c["cta"]; var cb = c["cta.buttons"].Links(); }
<section class="section section--accent">
    <div class="wrap support">
        <div>
            <p class="eyebrow eyebrow--on-accent">@cta.Inline("eyebrow")</p>
            <h2 class="h2">@cta.Inline("title")</h2>
        </div>
        <div class="support__body">
            <p>@cta.Inline()</p>
            <div class="support__actions">
                @for (var i = 0; i < cb.Count; i++) { <CopyLink Link="@cb[i]" Class="@(i == 0 ? "btn btn--ink" : "btn btn--ghost-on-accent")" /> }
            </div>
        </div>
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/projects");
}
