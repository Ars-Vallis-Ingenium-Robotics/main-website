@page "/leadership"
@using AviSite.Web.Content

<PageTitle>Leadership · AVI Robotics</PageTitle>
<HeadContent><meta name="description" content="Meet AVI Robotics' 2026–27 officers, leads and faculty advisors." /></HeadContent>

<PageHero Kicker="Leadership · 2026–27" Title="The people running the club.">
    <p>Officers are elected by members each spring. Leads guide each technical area. Faculty advisors keep us pointed in the right direction.</p>
</PageHero>

<section class="section">
    <div class="wrap">
        <h2 class="h3 group-title">Executive board</h2>
        <ul class="people">
            @foreach (var p in ClubFacts.Officers) { <li class="reveal"><PersonCard Person="p" /></li> }
        </ul>

        <h2 class="h3 group-title">Leads</h2>
        <ul class="people">
            @foreach (var p in ClubFacts.Leads) { <li class="reveal"><PersonCard Person="p" /></li> }
        </ul>

        <h2 class="h3 group-title">Advisors & mentors</h2>
        <ul class="people">
            @foreach (var p in ClubFacts.Advisors) { <li class="reveal"><PersonCard Person="p" /></li> }
        </ul>

        <p class="note">Portraits coming soon. Officers: send a headshot to marketing to be added.</p>
    </div>
</section>

<section class="section section--flush">
    <Photo Key="worlds-team-rosie" Sizes="100vw" Class="photo--wide parallax" />
</section>
