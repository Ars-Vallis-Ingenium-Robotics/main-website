@page "/leadership"
@* Copy: content/pages/leadership.md · people: content/roster.md *@
@inject ClubData Data

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>

<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")">
    @c["hero"].Html()
</PageHero>

<section class="section">
    <div class="wrap">
        @foreach (var g in c["groups"].Rows())
        {
            var feature = g[0] is "advisors" or "mentors";
            <h2 class="h3 group-title">@Copy.Inline(g.ElementAtOrDefault(1) ?? g[0])</h2>
            <ul class="people @(feature ? "people--feature" : "")">
                @foreach (var p in Data.Roster(g[0])) { <li class="reveal"><PersonCard Person="p" /></li> }
            </ul>
        }
    </div>
</section>
@{ var f = c["founders"]; }
<section class="section section--paper-2" aria-labelledby="founders-title">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@f.Inline("eyebrow")</p>
            <h2 class="h2" id="founders-title">@f.Inline("title")</h2>
            <p class="lede">@f.Inline()</p>
            <CopyLink Link="@f.Link("link")" Class="link-arrow" />
        </div>
        <ul class="people people--founders">
            @foreach (var p in Data.Roster("founders")) { <li class="reveal"><PersonCard Person="p" /></li> }
        </ul>
    </div>
</section>

<section class="section section--flush">
    <Photo Key="@(c["photo"].Value("photo") ?? "fall-group-2026")" Sizes="100vw" Class="crew__photo" Caption="@c["photo"].Text("caption")" />
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/leadership");
}
