@page "/sponsors"
@using AviSite.Web.Content
@inject IOptions<SiteOptions> Site
@inject IOptions<NonprofitOptions> Nonprofit

<PageTitle>Support AVI · AVI Robotics</PageTitle>
<HeadContent><meta name="description" content="Sponsor or donate to AVI Robotics, a 501(c)(3) nonprofit at Fresno State. EIN 39-4775163. Gifts are tax-deductible." /></HeadContent>

<PageHero Kicker="@($"Support · {Nonprofit.Value.Status}")" Title="Put your name on the robot.">
    <p>Every dollar goes into parts, pool time and getting students to competition. AVI is a registered @Nonprofit.Value.Status, so your gift is tax-deductible.</p>
    <div class="actions">
        <a class="btn btn--accent btn--lg" href="/donate">Donate now</a>
        <a class="btn btn--ghost-on-ink" href="@Site.Value.SponsorPacketPath">Sponsorship packet (PDF)</a>
    </div>
</PageHero>

<section class="section">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">Where it goes</p>
            <h2 class="h2">A real season costs real money.</h2>
            <p class="lede">The 2026 season had a total value of about $34,000, including donated and reused parts. The biggest line was getting 13 students and two robots to Newfoundland.</p>
        </div>
        <div class="reveal">
            <SpecSheet Rows="@uses" />
            <p class="muted small">From the Sequoia Marine Solutions 2026 technical documentation, accounting section.</p>
        </div>
    </div>
</section>

<section class="section section--ink sponsors-hall" aria-labelledby="thanks-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow eyebrow--on-ink">2026 sponsors</p>
                <h2 class="h2" id="thanks-title">Thank you.</h2>
                <p class="lede-on-ink">These are the companies and organizations that got a first-year club to the World Championship. Their logos were on the back of every shirt we wore in St. John's.</p>
            </div>
        </div>
        <SponsorWall />
        <div class="sponsors-hall__shirt">
            <Photo Key="worlds-shirt-back" Sizes="(min-width: 56rem) 30vw, 70vw" Class="photo--frame" Ratio="4 / 5" Caption="The sponsor shirt at Worlds, June 2026." />
        </div>
    </div>
</section>

<section class="section section--ink">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow eyebrow--on-ink">How to give</p>
            <h2 class="h2">Sponsor a season, or just send us money.</h2>
        </div>
        <div class="reveal">
            <p class="lede-on-ink">Sponsors get their logo on the robot, the team shirt and this site, plus mentions in our technical documentation and presentation. Download the packet for tiers, or email us.</p>
            <SpecSheet Class="spec--on-ink" Rows="@nonprofitRows" />
            <div class="actions">
                <a class="btn btn--accent" href="/donate">Donate</a>
                <a class="btn btn--ghost-on-ink" href="@Site.Value.SponsorPacketPath">Sponsorship packet (PDF)</a>
                @if (Site.Value.ContactEmail is { } email) { <a class="btn btn--ghost-on-ink" href="mailto:@email?subject=Supporting%20AVI%20Robotics">Email @email</a> }
            </div>
        </div>
    </div>
</section>

@code {
    private readonly IReadOnlyList<(string, string)> uses =
    [
        ("Competition travel", "$18,869 · flights and hotel for 13 students in St. John's"),
        ("ROV electronics & controls", "Largest build category: thrusters, cameras, power"),
        ("Fundraising operations", "$2,405 · Vintage Days booth supplies"),
        ("Team operations", "$1,327 · shirts, booth, materials"),
        ("Admin & registration", "$877 · 501(c)(3) filing, CA DOJ, MATE registration"),
    ];

    private IReadOnlyList<(string, string)> nonprofitRows => [
        ("Organization", Nonprofit.Value.LegalName),
        ("Status", $"{Nonprofit.Value.Status} · contributions tax-deductible"),
        ("Tax ID", $"EIN {Nonprofit.Value.Ein}"),
    ];
}
