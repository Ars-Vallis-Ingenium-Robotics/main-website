@page "/sponsors"
@* Copy: content/pages/sponsors.md · logos: content/sponsors.md *@
@inject IOptions<SiteOptions> Site

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>
@{ var hb = c["hero.buttons"].Links(); }
<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")">
    @c["hero"].Html()
    <div class="actions">
        @for (var i = 0; i < hb.Count; i++) { <CopyLink Link="@hb[i]" Class="@(i == 0 ? "btn btn--accent btn--lg" : "btn btn--ghost-on-ink")" /> }
    </div>
</PageHero>
@{ var uses = c["uses"]; }
<section class="section">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@uses.Inline("eyebrow")</p>
            <h2 class="h2">@uses.Inline("title")</h2>
            <p class="lede">@uses.Inline()</p>
        </div>
        <div class="reveal">
            <SpecSheet Rows="@c["uses.spec"].Pairs()" />
            <p class="muted small">@uses.Inline("note")</p>
        </div>
    </div>
</section>
@{ var thanks = c["thanks"]; var tp = c["thanks.photos"].Rows(); }
<section class="section section--ink sponsors-hall" aria-labelledby="thanks-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow eyebrow--on-ink">@thanks.Inline("eyebrow")</p>
                <h2 class="h2" id="thanks-title">@thanks.Inline("title")</h2>
                <p class="lede-on-ink">@thanks.Inline()</p>
            </div>
        </div>
        <SponsorWall />
        <div class="sponsors-hall__photos">
            @if (tp.Count > 0) { <Photo Key="@tp[0][0]" Sizes="(min-width: 56rem) 30vw, 70vw" Class="photo--frame" Ratio="4 / 5" Caption="@Copy.Plain(tp[0].ElementAtOrDefault(1))" /> }
            @if (tp.Count > 1) { <Photo Key="@tp[1][0]" Sizes="(min-width: 56rem) 45vw, 100vw" Class="photo--frame" Ratio="4 / 5" Focus="62% 40%" Caption="@Copy.Plain(tp[1].ElementAtOrDefault(1))" /> }
        </div>
    </div>
</section>
@{ var levels = c["levels"]; }
<section class="section" aria-labelledby="levels-title">
    <div class="wrap">
        <div class="section__head">
            <div>
                <p class="eyebrow">@levels.Inline("eyebrow")</p>
                <h2 class="h2" id="levels-title">@levels.Inline("title")</h2>
            </div>
            <CopyLink Link="@levels.Link("link")" Class="link-arrow" />
        </div>
        <ol class="levels" role="list">
            @foreach (var l in levels.Items)
            {
                <li class="level reveal">
                    <span class="level__name">@l.Title</span>
                    <span class="level__amount mono">@l.Inline("amount")</span>
                    <ul class="level__perks">@foreach (var p in l.ListHtml()) { <li>@p</li> }</ul>
                </li>
            }
        </ol>
        <p class="muted small">@levels.Inline("note")</p>
    </div>
</section>
@{ var give = c["give"]; var gb = c["give.buttons"].Links(); }
<section class="section section--ink">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow eyebrow--on-ink">@give.Inline("eyebrow")</p>
            <h2 class="h2">@give.Inline("title")</h2>
        </div>
        <div class="reveal">
            <p class="lede-on-ink">@give.Inline()</p>
            <SpecSheet Class="spec--on-ink" Rows="@c["give.spec"].Pairs()" />
            <div class="actions">
                @for (var i = 0; i < gb.Count; i++) { <CopyLink Link="@gb[i]" Class="@(i == 0 ? "btn btn--accent" : "btn btn--ghost-on-ink")" /> }
                @if (Site.Value.ContactEmail is { } email) { <a class="btn btn--ghost-on-ink" href="mailto:@email?subject=Supporting%20AVI%20Robotics">Email @email</a> }
            </div>
        </div>
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/sponsors");
}
