@page "/history"
@* Copy: content/pages/history.md · timeline: content/timelines/history.md · founders: content/roster.md *@
@inject ClubData Data

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>

<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")">
    @c["hero"].Html()
</PageHero>
@{ var f = c["founders"]; }
<section class="section section--paper-2" aria-labelledby="founders-title">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@f.Inline("eyebrow")</p>
            <h2 class="h2" id="founders-title">@f.Inline("title")</h2>
            <p class="lede">@f.Inline()</p>
        </div>
        <ul class="people people--founders">
            @foreach (var p in Data.Roster("founders")) { <li class="reveal"><PersonCard Person="p" /></li> }
        </ul>
    </div>
</section>
@{ var next = c["timeline.next"]; var nl = next.Link("link"); }
<section class="section">
    <div class="wrap">
        <Timeline Items="@(Data.Timeline("history"))" Id="history" NextWhen="@next.Text("when")" NextTitle="@next.Text("title")"
                  NextBody="@next.Text()" NextHref="@nl.Href" NextLink="@nl.PlainText" />
    </div>
</section>
@{ var w = c["next"]; }
<section class="section section--ink">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow eyebrow--on-ink">@w.Inline("eyebrow")</p>
            <h2 class="h2">@w.Inline("title")</h2>
        </div>
        <div class="reveal">
            <p class="lede-on-ink">@w.Inline()</p>
            <CopyLink Link="@w.Link("button")" Class="btn btn--accent" />
        </div>
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/history");
}
