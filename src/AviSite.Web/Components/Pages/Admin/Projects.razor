@page "/admin/projects"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = AviSite.Web.Endpoints.AdminEndpoints.QrPolicy)]
@using AviSite.Web.Store
@using AviSite.Web.Endpoints
@inject IAccountStore Accounts
@inject ProjectPlans Plans
<PageTitle>Projects · AVI Robotics</PageTitle>
<HeadContent><meta name="robots" content="noindex" /><link rel="stylesheet" href="@Assets["css/projects.css"]" /></HeadContent>
<section class="section admin projects"><div class="wrap">
<AdminNav Current="projects" />
<header><p class="eyebrow">Project management</p><h1>Projects &amp; milestones</h1><p>Plan delivery, see what is due, and keep dependencies visible.</p></header>
@if (plans is not null)
{
<form method="post" action="/admin/projects/save" class="project-form"><AntiforgeryToken /><label>Team <select name="teamId" required>@foreach(var t in teams){<option value="@t.Id">@t.Name</option>}</select></label><label>Project <input name="title" maxlength="120" required /></label><label>Description <input name="description" maxlength="2000" /></label><button class="btn btn--accent">Create project</button></form>
@if(plans.Count==0){<p>No active projects in your organization.</p>}
<form method="get" class="project-form filters"><label>Show tasks <select name="filter"><option value="all">All projects</option><option value="overdue">Overdue tasks</option><option value="next">Due in 7 days</option></select></label><button class="btn btn--ghost">Filter</button></form>
@foreach(var p in plans){<article class="plan"><header><h2>@p.Title</h2><p>@p.Description</p><p class="muted">Updated @p.UpdatedUtc by @p.Actor</p></header>
@if(access!.CanManageGroup(p.TeamId)){<form method="post" action="/admin/projects/save" class="project-form"><AntiforgeryToken /><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="teamId" value="@p.TeamId"/><label>Rename project <input name="title" value="@p.Title" maxlength="120" required /></label><label>Description <input name="description" value="@p.Description" maxlength="2000" /></label><button class="btn btn--ghost">Save</button></form>
<form method="post" action="/admin/projects/@p.Id/archive"><AntiforgeryToken /><button class="btn btn--ghost">Archive</button></form>
<form method="post" action="/admin/projects/@p.Id/task" class="project-form"><AntiforgeryToken /><h3>Add milestone</h3><label>Title <input name="title" required maxlength="120" /></label><label>Owner email <input name="ownerEmail" type="email" required /></label><label>Status <select name="status"><option>Planned</option><option>In progress</option><option>Blocked</option><option>Done</option></select></label><label>Start <input name="startDate" type="date" required /></label><label>Due <input name="dueDate" type="date" required /></label><label>Progress % <input name="progress" type="number" min="0" max="100" value="0" required /></label><label>Description <input name="description" maxlength="2000" /></label>@foreach(var task in Plans.Tasks(p.Id)){<label class="check"><input type="checkbox" name="dependency" value="@task.Id" /> Depends on: @task.Title</label>}<button class="btn btn--accent">Add milestone</button></form>}
@{var tasks=Plans.Tasks(p.Id); var today=DateOnly.FromDateTime(DateTime.UtcNow); var visibleTasks=tasks.Where(t=>Filter!="overdue"||t.DueDate<today).Where(t=>Filter!="next"||t.DueDate>=today&&t.DueDate<=today.AddDays(7)).ToArray();var first=tasks.Count==0?today:tasks.Min(t=>t.StartDate);var last=tasks.Count==0?today.AddDays(1):tasks.Max(t=>t.DueDate);var span=Math.Max(1,last.DayNumber-first.DayNumber+1);}<div class="timeline" role="region" aria-label="Gantt timeline for @p.Title"><div class="gantt-scale"><span>@first.ToString("MMM d, yyyy")</span><span>@first.AddDays(span/2).ToString("MMM d")</span><span>@last.ToString("MMM d, yyyy")</span></div>@foreach(var t in visibleTasks){var left=Math.Clamp((t.StartDate.DayNumber-first.DayNumber)*100/span,0,99);var width=Math.Clamp((t.DueDate.DayNumber-t.StartDate.DayNumber+1)*100/span,1,100-left);<div class="gantt-row"><div class="gantt-label"><strong>@t.Title</strong><span>@t.StartDate — @t.DueDate · @t.Status · @t.Progress%</span><span>Depends on: @string.Join(", ",Plans.Dependencies(t.Id).Select(id=>tasks.FirstOrDefault(x=>x.Id==id)?.Title??"unknown"))</span></div><div class="gantt-track" role="img" aria-label="@t.Title: @t.StartDate through @t.DueDate"><span class="gantt-bar pos-@left len-@width">@t.Progress%</span></div></div>}<details class="schedule-table"><summary>Accessible schedule table</summary><table><caption>Project schedule</caption><thead><tr><th>Milestone</th><th>Owner</th><th>Status</th><th>Dates</th><th>Progress</th><th>Dependencies</th></tr></thead><tbody>@foreach(var t in visibleTasks){<tr class="@(t.DueDate<today?"overdue":"")"><th scope="row">@t.Title</th><td>@t.OwnerEmail</td><td>@t.Status</td><td>@t.StartDate — @t.DueDate</td><td>@t.Progress%</td><td>@string.Join(", ",Plans.Dependencies(t.Id).Select(id=>tasks.FirstOrDefault(x=>x.Id==id)?.Title??"unknown"))</td></tr>}</tbody></table></details></div>
<details><summary>Recent project history</summary><ol>@foreach(var ev in Plans.Events(p.Id)){<li>@ev.Action · @ev.Actor · <time datetime="@ev.AtUtc">@ev.AtUtc</time></li>}</ol></details>
<ul class="task-list" aria-label="Milestone list">@foreach(var t in tasks.OrderBy(t=>t.DueDate)){<li><strong>@t.Title</strong> · @t.OwnerEmail · @t.Status · due @t.DueDate · @t.Progress% @if(access!.CanManageGroup(p.TeamId)){<details><summary>Edit milestone</summary><form method="post" action="/admin/projects/@p.Id/task" class="project-form"><AntiforgeryToken /><input type="hidden" name="taskId" value="@t.Id"/><label>Title <input name="title" value="@t.Title" required maxlength="120" /></label><label>Owner <input name="ownerEmail" type="email" value="@t.OwnerEmail" required /></label><label>Status <select name="status"><option selected="@(t.Status=="Planned")">Planned</option><option selected="@(t.Status=="In progress")">In progress</option><option selected="@(t.Status=="Blocked")">Blocked</option><option selected="@(t.Status=="Done")">Done</option></select></label><label>Start <input name="startDate" type="date" value="@t.StartDate.ToString("yyyy-MM-dd")" required /></label><label>Due <input name="dueDate" type="date" value="@t.DueDate.ToString("yyyy-MM-dd")" required /></label><label>Progress % <input name="progress" type="number" min="0" max="100" value="@t.Progress" required /></label><label>Description <input name="description" value="@t.Description" maxlength="2000" /></label>@foreach(var dependency in tasks.Where(x=>x.Id!=t.Id)){<label class="check"><input type="checkbox" name="dependency" value="@dependency.Id" checked="@Plans.Dependencies(t.Id).Contains(dependency.Id)" /> Depends on: @dependency.Title</label>}<button class="btn btn--ghost">Save milestone</button></form></details>}</li>}</ul>
</article>}
}
</div></section>
@code {
 [Microsoft.AspNetCore.Components.Parameter, Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name="filter")] public string Filter {get;set;}="all";
 IReadOnlyList<ProjectPlan>? plans; Access? access; IEnumerable<AccountGroup> teams=[];
 protected override async Task OnInitializedAsync(){var context=Http.HttpContext;if(context is null)return;access=await context.AccessAsync(Accounts);var actor=access.Account?.Email;if(actor is not null){var visible=access.Tree.Ordered().Where(g=>access.CanSee(g.Id)).ToArray();teams=visible;plans=Plans.List(visible.Select(g=>g.Id));}}
 [Microsoft.AspNetCore.Components.Inject] private IHttpContextAccessor Http {get;set;}=default!;
}
