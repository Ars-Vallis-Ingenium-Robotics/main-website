@page "/admin/login"
@inject IOptions<AdminOptions> Admin
@inject IAccountStore Accounts
@inject IWebHostEnvironment Env

<PageTitle>Admin sign in · AVI Robotics</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="section">
    <div class="wrap narrow narrow--form admin-login">
        <p class="eyebrow">Officers, leads and members</p>
        <h1 class="h1">Sign in</h1>
        <p class="muted">Use the Google account an officer added. Officers get the shop, countdowns and every QR code; groups get their own QR codes.</p>

        @if (Message is { } m) { <p class="alert" role="alert">@m</p> }

        @if (Admin.Value.Google.Enabled)
        {
            <a class="btn btn--ink btn--lg admin-login__google" href="/admin/google@(ReturnUrl is null ? "" : "?returnUrl=" + Uri.EscapeDataString(ReturnUrl))">
                <svg viewBox="0 0 48 48" aria-hidden="true" width="20" height="20"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
                Sign in with Google
            </a>
        }
        else
        {
            <p class="alert">Google sign-in isn't set up on this server yet (<code>Admin:Google</code>, see README).</p>
        }

        @if (Env.IsDevelopment())
        {
            <form method="post" action="/admin/dev-login" class="form admin-login__dev">
                <AntiforgeryToken />
                <label class="field">
                    <span class="label">Local testing: sign in as</span>
                    <select name="email">
                        @foreach (var a in accounts) { <option value="@a.Email">@a.Email · @AccountRules.Label(a.Role)@(a.Group is null ? "" : $" · {a.Group}")</option> }
                    </select>
                </label>
                <button class="btn btn--ghost" type="submit">Sign in (dev only)</button>
            </form>
        }

        @if (!string.IsNullOrEmpty(Admin.Value.PasswordHash) || Admin.Value.Teams.Count > 0)
        {
            <details class="admin-login__password" open="@(Error == "1")">
                <summary>Use a shared password instead</summary>
                <p class="small muted">The old officer and team passwords still work while everyone moves to their own account. Once they have, remove them from the server.</p>
                <form method="post" action="/admin/login" class="form">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <label class="field">
                        <span class="label">Password</span>
                        <input type="password" name="password" autocomplete="current-password" required />
                    </label>
                    <button class="btn btn--ghost" type="submit">Sign in with password</button>
                </form>
            </details>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private IReadOnlyList<Account> accounts = [];

    private string? Message => Error switch
    {
        null => null,
        "1" => "Wrong password.",
        "not-listed" => "That Google account isn't on the list. Ask an officer (or your group's lead) to add the email you signed in with.",
        "cancelled" => "Sign-in was cancelled. Try again?",
        "expired" => "That sign-in took too long or was opened in another tab. Try again.",
        "google-off" => "Google sign-in isn't set up on this server yet.",
        _ => "Google sign-in didn't work. Try again in a minute.",
    };

    protected override async Task OnInitializedAsync()
    {
        if (Env.IsDevelopment()) accounts = await Accounts.ListAsync();
    }
}
