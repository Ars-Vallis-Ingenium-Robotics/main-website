@page "/admin/qr"
@attribute [Authorize(Policy = AviSite.Web.Endpoints.AdminEndpoints.QrPolicy)]
@using System.ComponentModel.DataAnnotations
@inject IDynamicQrStore Codes
@inject IOptions<SmsSiteOptions> SiteUrls
@inject NavigationManager Nav
@inject IOptions<AdminOptions> AdminOpts
@inject IAccountStore Accounts

<PageTitle>Dynamic QR codes · AVI Robotics admin</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="section admin">
    <div class="wrap">
        <AdminNav Current="qr" />
        <div class="section__head">
            <div>
                <p class="eyebrow">@(Team is null ? "Admin" : $"Team {Team.ToUpperInvariant()}")</p>
                <h1 class="h1">Dynamic QR codes</h1>
                <p class="muted">The printed code never changes. Change where it goes here, any time. Scans are counted here and sent to the Google Sheet.</p>
            </div>
        </div>

        @if (Saved is not null) { <p class="alert alert--ok" role="status">Saved <strong>@Saved</strong>.</p> }

        <div class="table-scroll">
            <table class="table qr-admin">
                <thead>
                    <tr><th scope="col">Code</th><th scope="col">Goes to</th><th scope="col" class="num">Scans</th><th scope="col" class="num">Last 7 days</th><th scope="col">Last scan</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var q in codes)
                    {
                        var url = PrintUrl(q.Slug);
                        <tr class="@(q.Active ? "" : "is-off")" data-qr-row="@q.Slug">
                            <th scope="row">
                                <a href="/admin/qr/@q.Slug"><strong>@q.Slug</strong></a>
                                @if (!q.Active) { <span class="tag">Off</span> }
                                @if (Team is null && q.Team is not null) { <span class="tag">@q.Team.ToUpperInvariant()</span> }
                                <div class="mono small muted">@url</div>
                                @if (q.Note is not null) { <div class="small">@q.Note</div> }
                            </th>
                            <td><a class="qr-admin__target" href="@q.Target" target="_blank" rel="noopener">@q.Target</a><div class="small muted">Sheet: @q.Campaign</div></td>
                            <td class="num">@q.Scans</td>
                            <td class="num">@Last7(q)</td>
                            <td class="small">@(q.LastScanUtc is { } t ? Local(t) : "Never")</td>
                            <td class="qr-admin__actions">
                                <a class="btn btn--ghost btn--sm" href="/admin/qr/@q.Slug">Edit</a>
                                <a class="btn btn--ghost btn--sm" href="/tools/qr?url=@Uri.EscapeDataString(url)&style=@(QrStyle)" target="_blank" rel="noopener">QR image</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h2 class="h3">Add a code</h2>
        <EditForm Model="New!" FormName="qr-new" OnValidSubmit="CreateAsync" method="post" class="form qr-admin__form" novalidate>
            <DataAnnotationsValidator />
            <div class="qr-admin__grid">
                <div class="field">
                    <label class="label" for="slug">Name in the link</label>
                    <InputText id="slug" @bind-Value="New!.Slug" placeholder="@(Team is null ? "e.g. vintage-days" : $"e.g. {Team}-pool-day")" autocomplete="off" aria-describedby="slug-hint" />
                    <span id="slug-hint" class="field__hint mono">@PrintUrl(string.IsNullOrWhiteSpace(New!.Slug) ? "…" : New.Slug.Trim().ToLowerInvariant())</span>
                </div>
                <div class="field">
                    <label class="label" for="target">Goes to</label>
                    <InputText id="target" @bind-Value="New!.Target" placeholder="https://…" inputmode="url" />
                </div>
                <div class="field">
                    <label class="label" for="campaign">Name in the Google Sheet</label>
                    <InputText id="campaign" @bind-Value="New!.Campaign" placeholder="e.g. Vintage Days 2027 flyer" />
                </div>
                @if (Team is null && groupIds.Count > 0)
                {
                    <div class="field">
                        <label class="label" for="owner">Group</label>
                        <InputSelect id="owner" @bind-Value="New!.Owner">
                            <option value="">Club-wide (officers)</option>
                            @foreach (var (id, name) in groupIds) { <option value="@id">@name (name must start with @(id)-)</option> }
                        </InputSelect>
                    </div>
                }
                <div class="field">
                    <label class="label" for="note">Note <span class="muted">(optional)</span></label>
                    <InputText id="note" @bind-Value="New!.Note" placeholder="Where it's printed" />
                </div>
            </div>
            @if (error is not null) { <p class="alert" role="alert">@error</p> }
            <div><button class="btn btn--accent" type="submit">Add code</button></div>
        </EditForm>

        <h2 class="h3 qr-admin__h">Add a batch</h2>
        <p class="muted">For things like weekly sign-ins: makes <span class="mono">prefix-1</span>, <span class="mono">prefix-2</span>… all pointing at the same place to start. Repoint each one when its week comes.</p>
        <EditForm Model="Batch!" FormName="qr-batch" OnValidSubmit="CreateBatchAsync" method="post" class="form qr-admin__form" novalidate>
            <DataAnnotationsValidator />
            <div class="qr-admin__grid">
                <div class="field">
                    <label class="label" for="b-prefix">Name in the link</label>
                    <InputText id="b-prefix" @bind-Value="Batch!.Prefix" placeholder="@(Team is null ? "e.g. sign-in" : $"e.g. {Team}-sign-in")" autocomplete="off" />
                    <span class="field__hint mono">…/dynamicqr/@(string.IsNullOrWhiteSpace(Batch!.Prefix) ? "sign-in" : Batch.Prefix.Trim().ToLowerInvariant())-@Batch.From</span>
                </div>
                <div class="field">
                    <label class="label" for="b-from">From</label>
                    <InputNumber id="b-from" @bind-Value="Batch!.From" min="0" max="999" />
                </div>
                <div class="field">
                    <label class="label" for="b-to">To</label>
                    <InputNumber id="b-to" @bind-Value="Batch!.To" min="0" max="999" />
                </div>
                <div class="field">
                    <label class="label" for="b-target">Goes to (for now)</label>
                    <InputText id="b-target" @bind-Value="Batch!.Target" placeholder="https://… or /join" inputmode="url" />
                </div>
                <div class="field">
                    <label class="label" for="b-campaign">Name in the Google Sheet</label>
                    <InputText id="b-campaign" @bind-Value="Batch!.Campaign" placeholder="Sign-in {n}" />
                    <span class="field__hint">{n} becomes the number.</span>
                </div>
            </div>
            @if (batchError is not null) { <p class="alert" role="alert">@batchError</p> }
            <div><button class="btn btn--accent" type="submit">Add batch</button></div>
        </EditForm>
        @if (BatchMade is not null)
        {
            var made = codes.Where(q => BatchMade.Split(',').Contains(q.Slug)).ToList();
            var lines = string.Join("\n", made.Select(q => $"{q.Campaign}, {PrintUrl(q.Slug)}"));
            <p class="alert alert--ok" role="status">Added @made.Count codes. <a href="/tools/qr#bulk=@Uri.EscapeDataString(lines)" target="_blank" rel="noopener">Make their QR images</a></p>
        }
    </div>
</section>

@code {
    private string QrStyle => Http?.User.FindFirst(AviSite.Web.Endpoints.AdminEndpoints.TeamClaim)?.Value is "sms" ? "sms" : "avi";
    [SupplyParameterFromForm(FormName = "qr-new")] public NewCode? New { get; set; }
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    [SupplyParameterFromQuery] public string? BatchMade { get; set; }
    [CascadingParameter] public HttpContext? Http { get; set; }
    /// <summary>Set for team logins: they only see and make codes named "&lt;team&gt;-…".</summary>
    private string? Team;
    /// <summary>Members only see the codes they made themselves.</summary>
    private string? memberEmail;
    private string? myEmail;
    /// <summary>Groups that can own codes: account groups plus the old shared team passwords.</summary>
    private List<(string Id, string Name)> groupIds = [];
    [SupplyParameterFromForm(FormName = "qr-batch")] public BatchCodes? Batch { get; set; }
    private string? batchError;
    private IReadOnlyList<DynamicQr> codes = [];
    private string? error;
    private static readonly TimeZoneInfo Pacific = TimeZoneInfo.FindSystemTimeZoneById("America/Los_Angeles");

    protected override async Task OnInitializedAsync()
    {
        New ??= new();
        Batch ??= new();
        Team = Http?.User.FindFirst(AviSite.Web.Endpoints.AdminEndpoints.TeamClaim)?.Value;
        myEmail = Http?.User.FindFirst(AviSite.Web.Endpoints.AccountAuth.EmailClaim)?.Value;
        memberEmail = Http?.User.IsInRole("Member") == true ? myEmail ?? "" : null;
        codes = (await Codes.ListAsync()).Where(q => (Team is null || q.Team == Team) && (memberEmail is null || q.CreatedBy == memberEmail)).ToList();
        groupIds = (await Accounts.GroupsAsync()).Select(g => (g.Id, g.Name))
            .Concat(AdminOpts.Value.Teams.Keys.Select(t => (t.ToLowerInvariant(), t.ToUpperInvariant())))
            .DistinctBy(g => g.Item1).ToList();
    }

    private string PrintUrl(string slug) => $"{SiteUrls.Value.AviBaseUrl.TrimEnd('/')}/dynamicqr/{slug}";
    private static int Last7(DynamicQr q)
    {
        var from = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Pacific).Date.AddDays(-6).ToString("yyyy-MM-dd");
        return q.Daily.Where(d => string.CompareOrdinal(d.Key, from) >= 0).Sum(d => d.Value);
    }
    private static string Local(DateTimeOffset t) => TimeZoneInfo.ConvertTime(t, Pacific).ToString("MMM d, h:mm tt");

    private async Task CreateAsync()
    {
        var slug = New!.Slug!.Trim().ToLowerInvariant();
        var owner = Team ?? (string.IsNullOrWhiteSpace(New.Owner) ? null : New.Owner);
        error = DynamicQrRules.CheckSlug(slug) ?? DynamicQrRules.CheckTeamSlug(slug, owner) ?? DynamicQrRules.CheckTarget(New.Target);
        if (error is not null) return;
        var ok = await Codes.CreateAsync(new DynamicQr
        {
            Slug = slug,
            Target = New.Target!.Trim(),
            Campaign = string.IsNullOrWhiteSpace(New.Campaign) ? slug : New.Campaign.Trim(),
            Note = string.IsNullOrWhiteSpace(New.Note) ? null : New.Note.Trim(),
            Team = owner,
            CreatedBy = myEmail,
        });
        if (!ok) { error = $"There's already a code called {slug}."; return; }
        Nav.NavigateTo($"/admin/qr?saved={Uri.EscapeDataString(slug)}");
    }

    private async Task CreateBatchAsync()
    {
        var b = Batch!;
        var prefix = (b.Prefix ?? "").Trim().ToLowerInvariant();
        batchError = DynamicQrRules.CheckSlug(prefix + "-1") ?? DynamicQrRules.CheckTeamSlug(prefix + "-1", Team) ?? DynamicQrRules.CheckTarget(b.Target);
        var batchOwner = Team ?? (prefix.Split('-')[0] is var p0 && groupIds.Any(g => g.Id == p0) ? p0 : null);
        if (batchError is null && (b.To < b.From || b.To - b.From >= 100)) batchError = "Pick a range of up to 100 numbers.";
        if (batchError is not null) return;
        var made = new List<string>();
        var skipped = 0;
        for (var n = b.From; n <= b.To; n++)
        {
            var slug = $"{prefix}-{n}";
            var ok = await Codes.CreateAsync(new DynamicQr
            {
                Slug = slug,
                Target = b.Target!.Trim(),
                Campaign = string.IsNullOrWhiteSpace(b.Campaign) ? slug : b.Campaign.Trim().Replace("{n}", n.ToString()),
                Team = batchOwner,
                CreatedBy = myEmail,
            });
            if (ok) made.Add(slug); else skipped++;
        }
        if (made.Count == 0) { batchError = "All of those names already exist."; return; }
        Nav.NavigateTo($"/admin/qr?saved={Uri.EscapeDataString($"{made.Count} codes" + (skipped > 0 ? $" ({skipped} already existed)" : ""))}&batchMade={Uri.EscapeDataString(string.Join(',', made))}");
    }

    public sealed class BatchCodes
    {
        [Required(ErrorMessage = "Give the batch a name.")] public string? Prefix { get; set; }
        public int From { get; set; } = 1;
        public int To { get; set; } = 12;
        [Required(ErrorMessage = "Where should they go for now?")] public string? Target { get; set; }
        [StringLength(80)] public string? Campaign { get; set; } = "Sign-in {n}";
    }

    public sealed class NewCode
    {
        [Required(ErrorMessage = "Give it a short name.")] public string? Slug { get; set; }
        [Required(ErrorMessage = "Where should it go?")] public string? Target { get; set; }
        [StringLength(80)] public string? Campaign { get; set; }
        [StringLength(120)] public string? Note { get; set; }
        public string? Owner { get; set; }
    }
}
