@page "/admin/hours/report"
@attribute [Authorize(Policy = AviSite.Web.Endpoints.AdminEndpoints.QrPolicy)]
@using AviSite.Web.Endpoints
@inject IAccountStore Accounts
@inject HoursStore Store
@inject BrandingStore Branding
@inject NavigationManager Nav

<PageTitle>@(sponsor ? "Hours summary" : "Hours report") · @(r?.Brand.Name ?? "AVI Robotics")</PageTitle>
<HeadContent><meta name="robots" content="noindex" /><link rel="stylesheet" href="@Assets["css/brand-fonts.css"]" /></HeadContent>

@if (r is not null)
{
    <section class="section admin hours report report--@(sponsor ? "sponsor" : "internal")" style="@r.Brand.CssVars">
        <div class="wrap">
            <div class="no-print"><AdminNav Current="hours" /></div>

            <div class="report__toolbar no-print">
                <p class="eyebrow"><a href="/admin/hours">Hours</a> / Report</p>
                <nav class="report__audience" aria-label="Report version">
                    <a href="/admin/hours/report?@r.Query(ReportAudience.Internal)" aria-current="@(sponsor ? null : "page")">Internal</a>
                    <a href="/admin/hours/report?@r.Query(ReportAudience.Sponsor)" aria-current="@(sponsor ? "page" : null)" data-audience-sponsor>For sponsors</a>
                </nav>
                <div class="hours__leadlinks">
                    <a class="btn btn--accent btn--sm" href="/admin/hours/report.pdf?@r.Query()" data-report-pdf>Download PDF</a>
                    @if (!sponsor) { <a class="btn btn--ghost btn--sm" href="/admin/hours/export.csv?@r.Query()">Download CSV</a> }
                    <button class="btn btn--ghost btn--sm" type="button" data-print>Print</button>
                </div>
                <p class="small muted">@(sponsor ? "For sponsors and grants: totals and charts, no names." : "Internal: includes each person's hours. Use \"For sponsors\" for anything you send outside the team.")</p>
            </div>

            <div class="no-print"><HoursFilter Teams="r.Teams" Tree="r.Access.Tree" Team="@r.Team" Range="@r.Range" View="@(sponsor ? "sponsor" : null)" ShowSearch="false" Action="/admin/hours/report" /></div>

            <header class="report__brand">
                <div class="report__brand-id">
                    @if (r.Brand.LogoUrl is { } logo) { <img class="report__logo" src="@logo" alt="@r.Brand.Name" /> }
                    <div>
                        <p class="report__org">@r.Brand.Name</p>
                        @if (r.Brand.Tagline is { } tag) { <p class="report__tagline">@tag</p> }
                    </div>
                </div>
                <div class="report__title">
                    <h1 class="report__h1">@(sponsor ? "Hours summary" : "Hours report")</h1>
                    <p class="report__scope">@r.ScopeName · @r.RangeLabel</p>
                </div>
            </header>

            <div class="hours__totals report__stats" data-report-total-hours="@r.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <div class="stat"><span class="stat__num">@HoursText.Hours(r.Total)</span><span class="stat__label">hours</span></div>
                <div class="stat"><span class="stat__num">@r.People</span><span class="stat__label">@(r.People == 1 ? "person" : "people") logged time</span></div>
                <div class="stat"><span class="stat__num">@r.Sessions</span><span class="stat__label">sessions</span></div>
                <div class="stat"><span class="stat__num">@HoursText.Hours(r.People == 0 ? 0 : r.Total / r.People)</span><span class="stat__label">hours per person</span></div>
            </div>

            @if (r.Total <= 0)
            {
                <p class="muted">No hours in this range yet.</p>
            }
            else
            {
                <section class="report__block">
                    <h2 class="report__h2">Hours per @(r.Weekly ? "week" : "month")</h2>
                    <ColumnChart Points="r.OverTime" Label="@($"Hours per {(r.Weekly ? "week" : "month")}, {r.RangeLabel}")" />
                    <ReportTable Rows="r.OverTime.Select(p => (p.Label, p.Value)).ToList()" Head="@(r.Weekly ? "Week of" : "Month")" />
                </section>

                <div class="report__pair">
                    <section class="report__block">
                        <h2 class="report__h2">By category</h2>
                        <HoursPieChart Rows="r.ByCategory" Label="@($"Hours by category, {r.ScopeName}, {r.RangeLabel}")" />
                    </section>
                    <section class="report__block">
                        <h2 class="report__h2">By team</h2>
                        <HBars Rows="r.ByTeam" />
                    </section>
                </div>

                @if (sponsor)
                {
                    <p class="report__note">@r.People @(r.People == 1 ? "person" : "people") logged @HoursText.Hours(r.Total) hours across @r.ByTeam.Count @(r.ByTeam.Count == 1 ? "team" : "teams"), @r.RangeLabel.ToLowerInvariant().</p>
                }
                else
                {
                    <section class="report__block report__people" data-report-people>
                        <h2 class="report__h2">By person@(r.ByPerson.Count > 25 ? " (top 25)" : "")</h2>
                        <HBars Rows="r.ByPerson.Take(25).ToList()" />
                    </section>

                    <section class="report__block report__people">
                        <h2 class="report__h2">Everyone, by category</h2>
                        <div class="table-scroll">
                            <table class="table report__matrix">
                                <thead><tr><th scope="col">Person</th>@foreach (var c in r.ByCategory) { <th scope="col" class="num">@c.Label</th> }<th scope="col" class="num">Total</th></tr></thead>
                                <tbody>
                                    @foreach (var (person, cells, sum) in r.Matrix)
                                    {
                                        <tr><th scope="row">@person</th>@foreach (var v in cells) { <td class="num mono">@(v > 0 ? HoursText.Hours(v) : "")</td> }<td class="num mono"><strong>@HoursText.Hours(sum)</strong></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            }

            <footer class="report__footer">
                @if (r.Brand.Footer is { } f) { <p>@f</p> }
                <p class="small muted">Generated @r.Generated.ToPacific().ToString("MMM d, yyyy h:mm tt") Pacific. Sessions still running count up to now.</p>
            </footer>
        </div>
    </section>
}
<script src="/js/hours.js" defer></script>

@code {
    [CascadingParameter] public HttpContext? Http { get; set; }
    [SupplyParameterFromQuery] public string? Team { get; set; }
    [SupplyParameterFromQuery] public string? Range { get; set; }
    [SupplyParameterFromQuery] public string? View { get; set; }

    private HoursReportData? r;
    private bool sponsor;

    protected override async Task OnInitializedAsync()
    {
        r = await HoursReportData.BuildAsync(Http!, Accounts, Store, Branding, Team, Range, View);
        if (r is null) { Nav.NavigateTo("/admin/hours"); return; }
        sponsor = r.Audience == ReportAudience.Sponsor;
    }
}
