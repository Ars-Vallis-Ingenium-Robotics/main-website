@page "/admin/qr/{Slug}"
@attribute [Authorize(Policy = AviSite.Web.Endpoints.AdminEndpoints.QrPolicy)]
@using System.ComponentModel.DataAnnotations
@inject IDynamicQrStore Codes
@inject IOptions<SmsSiteOptions> SiteUrls
@inject NavigationManager Nav

<PageTitle>@Slug · Dynamic QR · AVI Robotics admin</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

@if (qr is not null)
{
    var url = $"{SiteUrls.Value.AviBaseUrl.TrimEnd('/')}/dynamicqr/{qr.Slug}";
    <section class="section admin">
        <div class="wrap narrow">
            <AdminNav Current="qr" />
            <p class="eyebrow"><a href="/admin/qr">Dynamic QR codes</a> / @qr.Slug</p>
            <h1 class="h1">@qr.Slug</h1>
            <p class="mono small">@url</p>
            <div class="qr-lookline">
                <a class="btn btn--ghost btn--sm" href="/tools/qr?url=@Uri.EscapeDataString(url)&style=@(QrStyle)&code=@qr.Slug" target="_blank" rel="noopener">@(qr.Look is null ? "Make the QR image" : "QR image (saved look)")</a>
                <span class="small muted">@(qr.Look is null
                    ? "No saved look yet: style it in the maker and press \"Save this look to the code\" so every reprint matches."
                    : $"Look saved {TimeZoneInfo.ConvertTime(qr.LookUpdatedUtc ?? qr.UpdatedUtc, Pacific):MMM d}{(qr.LookBy is null ? "" : " by " + qr.LookBy)}. Change it from the maker.")</span>
            </div>

            <EditForm Model="Edit!" FormName="qr-edit" OnValidSubmit="SaveAsync" method="post" class="form" novalidate>
                <DataAnnotationsValidator />
                <div class="field">
                    <label class="label" for="target">Goes to</label>
                    <InputText id="target" @bind-Value="Edit!.Target" inputmode="url" />
                    <span class="field__hint">Takes effect on the next scan. People who already scanned keep whatever page they opened.</span>
                </div>
                <div class="field">
                    <label class="label" for="campaign">Name in the Google Sheet</label>
                    <InputText id="campaign" @bind-Value="Edit!.Campaign" />
                </div>
                <div class="field">
                    <label class="label" for="note">Note <span class="muted">(optional)</span></label>
                    <InputText id="note" @bind-Value="Edit!.Note" />
                </div>
                <label class="check"><InputCheckbox @bind-Value="Edit!.Active" /> On (when off, scans go to the home page and aren't counted)</label>
                @if (error is not null) { <p class="alert" role="alert">@error</p> }
                <div class="actions"><button class="btn btn--accent" type="submit">Save</button><a class="btn btn--ghost" href="/admin/qr">Cancel</a></div>
            </EditForm>

            <h2 class="h3 qr-admin__h">Scans, last 30 days</h2>
            <p class="muted small">@qr.Scans total@(qr.LastScanUtc is { } t ? $" · last {TimeZoneInfo.ConvertTime(t, Pacific):MMM d, h:mm tt}" : "").</p>
            <ol class="qr-bars" aria-label="Scans per day, last 30 days">
                @foreach (var (day, n) in days)
                {
                    <li style="--h: @(max == 0 ? 0 : n * 100 / max)%" title="@day: @n"><span class="visually-hidden">@day: @n</span></li>
                }
            </ol>

            @if (qr.Scans > 0)
            {
                var wk = qr.Weekday is { Length: 7 } ? qr.Weekday : new int[7];
                var hr = qr.Hour is { Length: 24 } ? qr.Hour : new int[24];
                var wkMax = Math.Max(1, wk.Max()); var hrMax = Math.Max(1, hr.Max());
                var devTotal = Math.Max(1, qr.Devices.Values.Sum());
                <p class="qr-insight">@Busiest(wk, hr)</p>
                <div class="qr-stats">
                    <figure class="qr-stat">
                        <figcaption>By day of the week</figcaption>
                        <ol class="qr-cols" aria-label="Scans by day of the week">
                            @for (var i = 0; i < 7; i++)
                            {
                                var d = (i + 1) % 7; // Monday first
                                <li style="--h: @(wk[d] * 100 / wkMax)%" title="@Days[d]: @wk[d]"><span class="qr-cols__bar"></span><span class="qr-cols__x">@Days[d][..3]</span><span class="visually-hidden">: @wk[d]</span></li>
                            }
                        </ol>
                    </figure>
                    <figure class="qr-stat">
                        <figcaption>By time of day</figcaption>
                        <ol class="qr-cols qr-cols--hours" aria-label="Scans by hour of the day">
                            @for (var h = 0; h < 24; h++)
                            {
                                <li style="--h: @(hr[h] * 100 / hrMax)%" title="@HourLabel(h): @hr[h]"><span class="qr-cols__bar"></span><span class="qr-cols__x">@(h % 6 == 0 ? HourLabel(h) : "")</span><span class="visually-hidden">@HourLabel(h): @hr[h]</span></li>
                            }
                        </ol>
                    </figure>
                    <figure class="qr-stat">
                        <figcaption>By device</figcaption>
                        <ul class="qr-devices" role="list">
                            @foreach (var (name, n) in qr.Devices.OrderByDescending(x => x.Value))
                            {
                                <li><span>@name</span><span class="mono">@n · @(n * 100 / devTotal)%</span><span class="qr-devices__bar" style="--w: @(n * 100 / devTotal)%"></span></li>
                            }
                        </ul>
                        @if (qr.Devices.Count == 0) { <p class="muted small">Device counts start with the next scan.</p> }
                    </figure>
                </div>
                <p class="muted small">Times are Pacific. Devices come from the browser's own description; nothing personal is stored.</p>
            }

            <details class="qr-delete" open="@(deleteError is not null)">
                <summary>Delete this code</summary>
                <p class="small">It disappears from this list and its scans stop being counted. Anyone who scans a copy that's already printed lands on the AVI home page.
                    The name <span class="mono">@qr.Slug</span> stays reserved so nobody can point old prints somewhere else.
                    To pause it instead, untick <strong>On</strong> above.</p>
                <EditForm Model="Delete!" FormName="qr-delete" OnSubmit="DeleteAsync" method="post" class="form" novalidate>
                    <label class="check"><InputCheckbox @bind-Value="Delete!.Confirm" /> I understand printed copies will stop going to @qr.Target</label>
                    @if (deleteError is not null) { <p class="alert" role="alert">@deleteError</p> }
                    <div><button class="btn btn--ghost btn--danger" type="submit">Delete @qr.Slug</button></div>
                </EditForm>
            </details>
        </div>
    </section>
}

@code {
    [SupplyParameterFromForm(FormName = "qr-delete")] public DeleteModel? Delete { get; set; }
    private string? deleteError;

    private async Task DeleteAsync()
    {
        if (!Delete!.Confirm) { deleteError = "Tick the box first: printed copies stop going where they go now."; return; }
        await Codes.DeleteAsync(qr!.Slug, Http?.User.FindFirst(AviSite.Web.Endpoints.AccountAuth.EmailClaim)?.Value ?? Http?.User.Identity?.Name);
        Nav.NavigateTo($"/admin/qr?deleted={Uri.EscapeDataString(qr.Slug)}");
    }

    public sealed class DeleteModel { public bool Confirm { get; set; } }

    private string QrStyle => Http?.User.FindFirst(AviSite.Web.Endpoints.AdminEndpoints.TeamClaim)?.Value is "sms" ? "sms" : "avi";
    [Parameter] public string Slug { get; set; } = "";
    [CascadingParameter] public HttpContext? Http { get; set; }
    private static readonly string[] Days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    private static string HourLabel(int h) => h == 0 ? "12 AM" : h < 12 ? $"{h} AM" : h == 12 ? "12 PM" : $"{h - 12} PM";
    private static string Busiest(int[] wk, int[] hr)
    {
        if (wk.Sum() == 0) return "";
        var d = Array.IndexOf(wk, wk.Max()); var h = Array.IndexOf(hr, hr.Max());
        return $"Busiest: {Days[d]}s, around {HourLabel(h)}.";
    }
    [SupplyParameterFromForm(FormName = "qr-edit")] public EditModel? Edit { get; set; }
    private DynamicQr? qr;
    private string? error;
    private List<(string Day, int N)> days = [];
    private int max;
    private static readonly TimeZoneInfo Pacific = TimeZoneInfo.FindSystemTimeZoneById("America/Los_Angeles");

    protected override async Task OnInitializedAsync()
    {
        qr = await Codes.GetAsync(Slug);
        if (qr is null || Http is null || !DynamicQrRules.CanAccess(Http.User, qr)) { qr = null; Nav.NotFound(); return; }
        Edit ??= new() { Target = qr.Target, Campaign = qr.Campaign, Note = qr.Note, Active = qr.Active };
        Delete ??= new();
        var today = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Pacific).Date;
        days = Enumerable.Range(0, 30).Select(i => today.AddDays(i - 29).ToString("yyyy-MM-dd"))
            .Select(d => (d, qr.Daily.GetValueOrDefault(d))).ToList();
        max = days.Max(d => d.N);
    }

    private async Task SaveAsync()
    {
        error = DynamicQrRules.CheckTarget(Edit!.Target);
        if (error is not null) return;
        await Codes.UpdateAsync(qr!.Slug, c =>
        {
            c.Target = Edit.Target!.Trim();
            c.Campaign = string.IsNullOrWhiteSpace(Edit.Campaign) ? c.Slug : Edit.Campaign.Trim();
            c.Note = string.IsNullOrWhiteSpace(Edit.Note) ? null : Edit.Note.Trim();
            c.Active = Edit.Active;
        });
        Nav.NavigateTo($"/admin/qr?saved={Uri.EscapeDataString(qr.Slug)}");
    }

    public sealed class EditModel
    {
        [Required(ErrorMessage = "Where should it go?")] public string? Target { get; set; }
        [StringLength(80)] public string? Campaign { get; set; }
        [StringLength(120)] public string? Note { get; set; }
        public bool Active { get; set; } = true;
    }
}
