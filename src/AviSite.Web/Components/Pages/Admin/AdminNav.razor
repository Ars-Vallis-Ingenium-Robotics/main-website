@* Shared header for admin pages: section switcher + sign out. Team logins only see their QR codes. *@
<nav class="admin-nav" aria-label="Admin">
    @if (isAdmin)
    {
        <a href="/admin" class="@(Current == "orders" ? "is-current" : "")" aria-current="@(Current == "orders" ? "page" : null)">Shop orders</a>
    }
    <a href="/admin/qr" class="@(Current == "qr" ? "is-current" : "")" aria-current="@(Current == "qr" ? "page" : null)">@(isAdmin ? "Dynamic QR codes" : lead || team is not null ? "Team QR codes" : "My QR codes")</a>
    @if (isAdmin)
    {
        <a href="/admin/countdowns" class="@(Current == "countdowns" ? "is-current" : "")" aria-current="@(Current == "countdowns" ? "page" : null)">Countdowns</a>
        <a href="/admin/usage" class="@(Current == "usage" ? "is-current" : "")" aria-current="@(Current == "usage" ? "page" : null)">Tool usage</a>
    }
    @if (canPeople)
    {
        <a href="/admin/people" class="@(Current == "people" ? "is-current" : "")" aria-current="@(Current == "people" ? "page" : null)">People</a>
    }
    <form method="post" action="/admin/logout"><AntiforgeryToken /><button class="link-button" type="submit">Sign out (@who)</button></form>
</nav>

@code {
    [Parameter] public string Current { get; set; } = "";
    [CascadingParameter] public HttpContext? Http { get; set; }
    private bool isAdmin;
    private string? team;
    private bool lead, canPeople;
    private string who = "";
    protected override void OnInitialized()
    {
        var u = Http?.User;
        isAdmin = u?.IsInRole("Admin") == true;
        team = u?.FindFirst(AviSite.Web.Endpoints.AdminEndpoints.TeamClaim)?.Value;
        lead = u?.IsInRole("Lead") == true;
        canPeople = u?.FindFirst(AviSite.Web.Endpoints.AccountAuth.EmailClaim) is not null && (isAdmin || lead);
        // Accounts show their name; the old shared passwords show what they unlock.
        who = u?.FindFirst(AviSite.Web.Endpoints.AccountAuth.EmailClaim) is not null ? u.Identity?.Name ?? ""
            : team is not null ? team.ToUpperInvariant() + " password" : "officer password";
    }
}
