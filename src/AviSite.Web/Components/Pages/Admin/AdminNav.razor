@* Shared header for admin pages: section switcher + sign out. *@
<nav class="admin-nav" aria-label="Admin">
    <a href="/admin" class="@(Current == "orders" ? "is-current" : "")" aria-current="@(Current == "orders" ? "page" : null)">Shop orders</a>
    <a href="/admin/qr" class="@(Current == "qr" ? "is-current" : "")" aria-current="@(Current == "qr" ? "page" : null)">Dynamic QR codes</a>
    <form method="post" action="/admin/logout"><AntiforgeryToken /><button class="link-button" type="submit">Sign out</button></form>
</nav>

@code {
    [Parameter] public string Current { get; set; } = "";
}
