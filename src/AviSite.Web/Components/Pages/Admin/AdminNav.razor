@* Shared header for admin pages: section switcher + sign out, and (for leads) a warning about forgotten clock-outs. *@
@using AviSite.Web.Endpoints
@inject IAccountStore Accounts
@inject HoursStore Hours
@inject ProfileStore Profiles
<nav class="admin-nav" aria-label="Admin">
    @if (hasAccount)
    {
        <a href="/admin/tools" class="@(Current == "tools" ? "is-current" : "")" aria-current="@(Current == "tools" ? "page" : null)">Tools</a>
        <a href="/admin/hours" class="@(Current == "hours" ? "is-current" : "")" aria-current="@(Current == "hours" ? "page" : null)">Hours</a>
        <a href="/admin/purchasing" class="@(Current == "purchasing" ? "is-current" : "")" aria-current="@(Current == "purchasing" ? "page" : null)">Purchasing</a>
        <a href="/admin/inventory" class="@(Current == "inventory" ? "is-current" : "")" aria-current="@(Current == "inventory" ? "page" : null)">Inventory</a>
        <a href="/admin/projects" class="@(Current == "projects" ? "is-current" : "")" aria-current="@(Current == "projects" ? "page" : null)">Projects</a>
        <a href="/admin/decision-matrices" class="@(Current == "decision-matrices" ? "is-current" : "")" aria-current="@(Current == "decision-matrices" ? "page" : null)">Decision matrices</a>
        <a href="/admin/forms" class="@(Current == "forms" ? "is-current" : "")" aria-current="@(Current == "forms" ? "page" : null)">Forms</a>
    }
    @if (isAdmin)
    {
        <a href="/admin" class="@(Current == "orders" ? "is-current" : "")" aria-current="@(Current == "orders" ? "page" : null)">Shop orders</a>
    }
    @if (hasAccount)
    {
        <a href="/admin/profile" class="@(Current == "profile" ? "is-current" : "")" aria-current="@(Current == "profile" ? "page" : null)">Profile</a>
    }
    <a href="/admin/qr" class="@(Current == "qr" ? "is-current" : "")" aria-current="@(Current == "qr" ? "page" : null)">@(isAdmin ? "Dynamic QR codes" : lead || team is not null ? "Team QR codes" : "My QR codes")</a>
    @if (isAdmin)
    {
        <a href="/admin/countdowns" class="@(Current == "countdowns" ? "is-current" : "")" aria-current="@(Current == "countdowns" ? "page" : null)">Countdowns</a>
        <a href="/admin/usage" class="@(Current == "usage" ? "is-current" : "")" aria-current="@(Current == "usage" ? "page" : null)">Tool usage</a>
    }
    @if (hasAccount && (isAdmin || lead))
    {
        @if (owner || lead)
        {
            <a href="/admin/branding" class="@(Current == "branding" ? "is-current" : "")" aria-current="@(Current == "branding" ? "page" : null)">Branding</a>
        }
        <a href="/admin/discord/bot" class="@(Current == "discord" ? "is-current" : "")" aria-current="@(Current == "discord" ? "page" : null)">Discord bot</a>
    }
    @if (canPeople)
    {
        <a href="/admin/people" class="@(Current == "people" ? "is-current" : "")" aria-current="@(Current == "people" ? "page" : null)">People</a>
    }
    <form method="post" action="/admin/logout"><AntiforgeryToken /><button class="link-button" type="submit">Sign out (@who)</button></form>
</nav>

@if (toReview > 0 && Current != "profile")
{
    <p class="review-banner" role="status" data-review-banner><strong>@toReview profile @(toReview == 1 ? "change is" : "changes are")</strong> waiting for your approval. <a href="/admin/profile/review">Review</a></p>
}
@if (forgotten.Count > 0)
{
    <div class="long-sessions" role="alert">
        <p class="long-sessions__title"><strong>@forgotten.Count @(forgotten.Count == 1 ? "person has" : "people have") been clocked in for over 24 hours.</strong> Probably a forgotten clock-out.</p>
        <ul role="list">
            @foreach (var (e, name) in forgotten)
            {
                <li data-long-session="@e.Id">
                    <span><strong>@name</strong> · @Tree.Name(e.Team) · since @e.StartUtc.ToPacific().ToString("ddd MMM d, h:mm tt", System.Globalization.CultureInfo.InvariantCulture) (@HoursText.Duration(e.Duration(Hours.Now)))</span>
                    <span class="long-sessions__actions">
                        <a class="btn btn--ghost btn--sm" href="mailto:@e.Email?subject=@Uri.EscapeDataString("Your hours: still clocked in?")&body=@Uri.EscapeDataString($"Hi {name}, the hours page shows you clocked in to {Tree.Name(e.Team)} since {e.StartUtc.ToPacific():ddd MMM d, h:mm tt}. When did you leave? I can fix the end time, or you can on /hours.")">Email them</a>
                        <a class="btn btn--ghost btn--sm" href="/admin/hours/team?fix=@e.Id#fix">Set the end time</a>
                    </span>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public string Current { get; set; } = "";
    [CascadingParameter] public HttpContext? Http { get; set; }
    private bool isAdmin, hasAccount;
    private string? team;
    private bool lead, canPeople, owner;
    private string who = "";
    private GroupTree Tree = new([]);
    private List<(HoursEntry Entry, string Name)> forgotten = [];
    private int toReview;

    protected override async Task OnInitializedAsync()
    {
        var u = Http?.User;
        isAdmin = u?.IsInRole("Admin") == true;
        team = u?.FindFirst(AdminEndpoints.TeamClaim)?.Value;
        lead = u?.IsInRole("Lead") == true;
        owner = u?.IsInRole("Owner") == true;
        hasAccount = u?.FindFirst(AccountAuth.EmailClaim) is not null;
        canPeople = hasAccount && (isAdmin || lead);
        // Accounts show their name; the old shared passwords show what they unlock.
        who = hasAccount ? u!.Identity?.Name ?? "" : team is not null ? team.ToUpperInvariant() + " password" : "officer password";

        if (Http is not null && hasAccount && (isAdmin || lead))
        {
            var me = await Http.AccessAsync(Accounts);
            var waiting = Profiles.Pending();
            if (waiting.Count > 0)
            {
                var all = (await Accounts.ListAsync()).ToDictionary(a => a.Email);
                toReview = waiting.Count(p => all.TryGetValue(p.Email, out var a) && ProfileRules.CanReview(me, a));
            }
        }

        // Leads, officers and the owner: anyone on their teams clocked in for more than a day, at the top of every admin page.
        if (Http is not null && (isAdmin || lead))
        {
            var access = await Http.AccessAsync(Accounts);
            Tree = access.Tree;
            var managed = HoursRules.ManagedTeams(access);
            if (managed.Count > 0)
            {
                var people = (await Accounts.ListAsync()).ToDictionary(a => a.Email);
                forgotten = Hours.LongRunning(managed)
                    .Where(e => e.Email != access.Account?.Email) // your own shows on your hours page
                    .Select(e => (e, people.TryGetValue(e.Email, out var p) ? JsonAccountStore.DisplayName(p) : e.Email)).ToList();
            }
        }
    }
}
