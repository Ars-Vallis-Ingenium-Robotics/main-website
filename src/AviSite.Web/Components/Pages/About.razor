@page "/about"
@* Copy: content/pages/about.md *@

<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>

<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")" Tone="blurple">
    @c["hero"].Html()
</PageHero>
@{ var purpose = c["purpose"]; }
<section class="section">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@purpose.Inline("eyebrow")</p>
            <h2 class="h2">@purpose.Inline("title")</h2>
        </div>
        <div class="prose reveal">@purpose.Html()</div>
    </div>
</section>
@{ var pillars = c["pillars"]; }
<section class="section section--paper-2" aria-labelledby="pillars-title">
    <div class="wrap">
        <p class="eyebrow">@pillars.Inline("eyebrow")</p>
        <h2 class="h2" id="pillars-title">@pillars.Inline("title")</h2>
        <ul class="pillars" role="list">
            @foreach (var (p, i) in pillars.Items.Select((p, i) => (p, i)))
            {
                <li class="pillar reveal"><span class="pillar__num mono">@((i + 1).ToString("00"))</span><h3 class="pillar__title">@p.Title</h3><p>@p.Inline()</p></li>
            }
        </ul>
    </div>
</section>
@{ var bcp = c["bcp"]; }
<section class="section" aria-labelledby="bcp-title">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@bcp.Inline("eyebrow")</p>
            <h2 class="h2" id="bcp-title">@bcp.Inline("title")</h2>
            <p class="lede">@bcp.Inline()</p>
            <Photo Key="@bcp.Photo" Sizes="(min-width: 56rem) 40vw, 100vw" Class="photo--frame" />
            <CopyLink Link="@bcp.Link("button")" Class="btn btn--accent" />
        </div>
        <div class="reveal">
            <SpecSheet Rows="@c["bcp.spec"].Pairs()" />
            <p class="muted small">@bcp.Inline("note")</p>
        </div>
    </div>
</section>

<section class="section section--flush" aria-label="Photos of AVI">
    <Collage Keys="@c["collage"].List()" Label="Photos of AVI" />
</section>
@{ var majors = c["majors"]; }
<section class="section">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow">@majors.Inline("eyebrow")</p>
            <h2 class="h2">@majors.Inline("title")</h2>
        </div>
        <div class="prose reveal">
            @majors.Html()
            <SpecSheet Rows="@c["majors.departments"].Pairs()" />
            <figure class="majors" aria-labelledby="majors-cap">
                <figcaption id="majors-cap" class="eyebrow">@majors.Inline("chart-title")</figcaption>
                @foreach (var row in c["majors.chart"].Rows())
                {
                    var pct = double.TryParse(row.ElementAtOrDefault(1), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
                    <div class="majors__row"><span>@Copy.Inline(row[0])</span><span class="majors__bar" style="--pct: @pct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span><span class="mono">@pct.ToString("0.#")%</span></div>
                }
            </figure>
        </div>
    </div>
</section>
@{ var np = c["nonprofit"]; }
<section class="section section--ink">
    <div class="wrap split">
        <div class="split__head">
            <p class="eyebrow eyebrow--on-ink">@np.Inline("eyebrow")</p>
            <h2 class="h2">@np.Inline("title")</h2>
        </div>
        <div class="reveal">
            <p class="lede-on-ink">@np.Inline()</p>
            <SpecSheet Class="spec--on-ink" Rows="@c["nonprofit.spec"].Pairs()" />
            <CopyLink Link="@np.Link("button")" Class="btn btn--accent" />
        </div>
    </div>
</section>

@code {
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/about");
}
