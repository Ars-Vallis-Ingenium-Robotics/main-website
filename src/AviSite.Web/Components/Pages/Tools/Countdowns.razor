@page "/countdown"
@page "/countdowns"
@* Events: managed in /admin/countdowns (App_Data/countdowns.json). Copy: content/pages/tools.md (## countdown). Live ticking: wwwroot/js/countdown.js *@
@inject ICountdownStore Store
@inject TimeProvider Clock

<PageTitle>Countdowns · AVI Robotics</PageTitle>
<HeadContent><meta name="description" content="AVI Robotics and Sequoia Marine Solutions: competitions, deadlines, fundraisers and test days, counting down." /></HeadContent>

<PageHero Kicker="@c["countdown"].Text("kicker")" Title="@c["countdown"].Text("title")">
    <p>@c["countdown"].Inline()</p>
</PageHero>

<section class="section">
    <div class="wrap" data-countdowns>
        @if (live.Count == 0)
        {
            <p class="countdowns__empty">@c["countdown.empty"].Inline()</p>
        }
        else
        {
            <ol class="countdowns" role="list">
                @foreach (var e in live) { <li>@Card(e, false)</li> }
            </ol>
        }

        @if (done.Count > 0)
        {
            <h2 class="h3 countdowns__done-title">Done</h2>
            <ol class="countdowns countdowns--done" role="list">
                @foreach (var e in done) { <li>@Card(e, true)</li> }
            </ol>
        }
    </div>
</section>

<script src="/js/countdown.js" defer></script>

@code {
    private PageCopy c = default!;
    private List<CountdownEvent> live = [], done = [];
    private DateTimeOffset now;
    private static readonly TimeZoneInfo Pacific = TimeZoneInfo.FindSystemTimeZoneById("America/Los_Angeles");
    private static readonly Dictionary<string, string> TypeLabels = new()
    {
        ["competition"] = "Competition", ["deadline"] = "Deadline", ["testing"] = "Testing", ["fundraiser"] = "Fundraiser",
        ["worlds"] = "Worlds", ["outreach"] = "Outreach", ["meeting"] = "Meeting",
    };

    protected override async Task OnInitializedAsync()
    {
        c = Copy.Page("pages/tools");
        now = Clock.GetUtcNow();
        var all = await Store.ListAsync();
        live = all.Where(e => (e.End ?? e.Start) > now)
            .OrderBy(e => e.Start <= now ? 0 : 1).ThenBy(e => e.Start).ToList();
        done = all.Where(e => (e.End ?? e.Start) <= now).OrderByDescending(e => e.End ?? e.Start).Take(6).ToList();
    }

    private RenderFragment Card(CountdownEvent e, bool isDone) => __builder =>
    {
        var now2 = now;
        var state = isDone ? "done" : e.Start <= now2 ? "now" : "soon";
        <article class="countdown countdown--@e.Type is-@state" data-start="@e.Start.ToUniversalTime().ToString("o")" data-end="@(e.End?.ToUniversalTime().ToString("o"))">
            <p class="countdown__tags mono">
                <span class="countdown__type">@(TypeLabels.GetValueOrDefault(e.Type, "Event"))</span>
                @if (e.Team is "sms") { <span>SMS</span> } else if (e.Team is "avi") { <span>AVI</span> }
                <span class="countdown__state" data-state>@(state switch { "now" => e.End is null ? "Now" : "Happening now", "done" => "Done", _ => "" })</span>
            </p>
            <h2 class="countdown__title">@e.Title</h2>
            <p class="countdown__when">@When(e)</p>
            @if (e.Where is not null) { <p class="countdown__where">@e.Where</p> }
            @if (!isDone)
            {
                <p class="countdown__clock mono" data-clock aria-live="off">
                    <span class="countdown__lead" data-lead>@(state == "now" ? "Ends in" : "Starts in")</span>
                    <span data-d>@Part(e, 0)</span><small>d</small>
                    <span data-h>@Part(e, 1)</span><small>h</small>
                    <span data-m>@Part(e, 2)</span><small>m</small>
                    <span data-s>@Part(e, 3)</span><small>s</small>
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(e.LinkUrl)) { <a class="link-arrow countdown__link" href="@e.LinkUrl" target="@(e.LinkUrl.StartsWith("http") ? "_blank" : null)" rel="@(e.LinkUrl.StartsWith("http") ? "noopener" : null)">@(e.LinkLabel ?? "Details")</a> }
        </article>
    };

    private string Part(CountdownEvent e, int i)
    {
        var target = e.Start > now ? e.Start : e.End ?? e.Start;
        var left = target - now;
        if (left < TimeSpan.Zero) left = TimeSpan.Zero;
        return i switch { 0 => ((int)left.TotalDays).ToString(), 1 => left.Hours.ToString("00"), 2 => left.Minutes.ToString("00"), _ => left.Seconds.ToString("00") };
    }

  
    private static string When(CountdownEvent e)
    {
        var s = e.Start; var en = e.End;
        var zone = e.TimeZone == CountdownZones.Default ? "" : $" ({CountdownZones.Label(e.TimeZone)} time)";
        string T(DateTimeOffset d) => d.ToString(d.Minute == 0 ? "h tt" : "h:mm tt");
        if (en is null) return $"{s:ddd, MMM d, yyyy} · {T(s)}{zone}";
        if (s.Date == en.Value.Date) return $"{s:ddd, MMM d, yyyy} · {T(s)} – {T(en.Value)}{zone}";
        return s.Month == en.Value.Month ? $"{s:MMM d} – {en.Value:d, yyyy}{zone}" : $"{s:MMM d} – {en.Value:MMM d, yyyy}{zone}";
    }
}
