@page "/shop"
@inject ICatalog Catalog
@inject IOptions<StoreOptions> Store

@* Copy: content/pages/shop.md (products: Store/catalog.seed.json) *@
<PageTitle>@c.Meta("title")</PageTitle>
<HeadContent><meta name="description" content="@c.Meta("description")" /></HeadContent>

@if (Store.Value.ComingSoon)
{
    var soon = c["coming-soon"];
    <PageHero Kicker="@soon.Text("kicker")" Title="@soon.Text("title")">
        <p>@soon.Inline()</p>
    </PageHero>
    <section class="section shop-soon" data-store="coming-soon">
        <div class="wrap shop-soon__inner">
            <p class="shop-soon__note">@c["coming-soon.note"].Inline()</p>
            <div class="shop-soon__actions">
                @foreach (var (b, i) in c["coming-soon.buttons"].Links().Select((b, i) => (b, i)))
                {
                    <a class="btn @(i == 0 ? "btn--accent" : "btn--ghost")" href="@b.Href" target="@b.Target" rel="@b.Rel">@b.Text</a>
                }
            </div>
        </div>
    </section>
}
else
{
<PageHero Kicker="@c["hero"].Text("kicker")" Title="@c["hero"].Text("title")">
    <p>@c["hero"].Inline() @Store.Value.PickupNote</p>
</PageHero>

<section class="section">
    <div class="wrap">
        @if (Error == "unavailable") { <p class="alert" role="alert">@c["unavailable"].Inline()</p> }
        @if (!Store.Value.OrdersOpen) { <p class="alert" role="status">@c["closed"].Inline()</p> }
        <ul class="product-grid">
            @foreach (var p in Catalog.Active) { <li><ProductCard Product="p" HeadingLevel="2" /></li> }
        </ul>
    </div>
</section>
}

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private PageCopy c = default!;
    protected override void OnInitialized() => c = Copy.Page("pages/shop");
}
